\import Data.Bool
\import Data.Maybe
\import Data.String
\import JavaAst
\import Set

-- =============================================================================
-- Runtime values, outcomes, and the runtime interface for the Java fragment.
--
-- The bottom layer of the fragment's semantics: `JavaEval.ard` is the evaluator,
-- and it cannot hold this, because `RtSpec` is a parameter of every rule and
-- `RtSpec` mentions `Value`.
--
-- NO STORE. The earlier version of this semantics (branch
-- `lambox-formal-semantics`) had one, and said why: "the generator mutates
-- exactly one thing: the `Rt.Fn[]` knot for `fix`, whose slots are filled after
-- the closures that read them have already captured the array". That knot is
-- gone -- `fix` is a local class whose methods reach each other through the class
-- declaration (see ToJava.ard) -- and `JStmt` has no assignment node at all. So
-- every value here is immutable after construction, a `Data`'s fields are values
-- rather than a heap reference, and the semantics is an environment semantics.
-- What that buys is not brevity: it is that the meaning of a generated program
-- no longer depends on WHEN anything is read.
--
-- Three value constructors went with the store, each for a stated reason:
-- `vArr` (no array node survives outside `jDataNew`/`jDataField`), `vNull`
-- (nothing in the fragment can produce it: no array is zero-filled and every
-- `jLocal` is initialized), and `vUninit` (`jLocal` carries an expression, so a
-- declared-but-unassigned local is unrepresentable rather than stuck).
--
-- Sources, as in the earlier version:
--   * ClightBigstep.v -- `outcome` is `StmtOut` below, Java-specialised.
--   * CompCert `Events.v` `external_call` -- the model for `RtSpec`: the
--     semantics QUANTIFIES over the runtime instead of defining it.
--   * Owens-Myreen-Kumar-Tan, "Functional Big-Step Semantics" (ESOP 2016) --
--     the clock discipline and `Res`'s timeout case.
--   * Charguéraud, "Pretty-Big-Step Semantics" (ESOP 2013) -- exceptions
--     duplicating every rule; `bindRes` is the functional answer, paid once.
-- =============================================================================

-- Every value the fragment can produce, and nothing else. Every static type in
-- the fragment is `Object`, so this is one flat sum rather than a hierarchy.
\data Value
  -- `Rt.BOX`, an erased proof or type. Identity-based in Java (`new Object()`),
  -- but nothing in the fragment tests identity, so one atom is faithful.
  | vBox
  -- `new Rt.Data(tag, new Object[]{ .. })`: a constructor application. The
  -- fields are VALUES -- see NO STORE above.
  | vData (tag : Nat) (fields : Array Value)
  -- `new Rt.Fn(){ public Object apply(Object p){ body } }`. The environment is
  -- captured by value at creation (JLS 15.9.5, 4.12.4). `Env` cannot be named
  -- yet (it is defined below, in terms of `Value`), so it is spelled out.
  | vClos (param : JIdent) (body : Array JStmt) (cenv : Array (\Sigma JIdent Value))
  -- An instance of a `fix` local class: its name, its methods (name, parameter,
  -- body) and the environment captured at the declaration.
  --
  -- ONE VALUE FOR THE CLASS AND ITS INSTANCES. `jLocalClass` binds this, and
  -- `new C()` evaluates to it rather than to something fresh. Faithful here
  -- because the instances are indistinguishable: the class has no fields, no
  -- constructor and no state, the captured locals are effectively final, and
  -- nothing in the fragment compares references. What a method call does with
  -- it is the interesting half -- see `jInvoke` in JavaEval.ard.
  | vObj (cname : JQIdent)
         (methods : Array (\Sigma JIdent JIdent (Array JStmt)))
         (cenv : Array (\Sigma JIdent Value))
  -- A runtime constant of `Rt` that is an `Fn`, with the arguments it has
  -- collected so far. `Rt.PRIM_ADD_LONG` is an `Fn` returning an `Fn`, so
  -- applying it accumulates until saturation; `builtinArity` is that contract,
  -- and its ABSENCE was the `Rt.curry` bug.
  | vBuiltin (name : JIdent) (got : Array Value)
  -- The class `Rt` as a receiver (`jStatic "Rt"`). Not a first-class value in
  -- Java either -- it only ever appears to the left of a field access.
  | vStaticRef JQIdent
  -- `Long.valueOf(5L)`: a boxed machine integer, signed, hence `Int`.
  | vLong Int
  | vStr String
  -- A decimal `int`: a constructor tag or a field index.
  | vInt Nat
  -- `d.tag == n` (JLS 15.21.1). The fragment's only boolean, and it exists only
  -- to be the condition of a `jCond`.
  | vBool Bool
  -- An exception OBJECT, not a thrown state: `new RuntimeException("..")`.
  -- Throwing it is a `StmtOut`.
  | vExcObj (excClass : JQIdent) (msg : String)

\func Env => Array (\Sigma JIdent Value)

-- ---------------------------------------------------------------------------
-- Results
--
-- `rStuck` ("the semantics does not define this") is deliberately distinct from
-- `rOutOfFuel` ("the clock ran out"): a differential test needs the difference,
-- since the first is a real disagreement with `java` and the second only a
-- budget that was too small.
-- ---------------------------------------------------------------------------

\data Res (A : \Type)
  | rOk A
  | rStuck
  | rOutOfFuel

\func bindRes {A B : \Type} (r : Res A) (f : A -> Res B) : Res B \elim r
  | rOk a => f a
  | rStuck => rStuck
  | rOutOfFuel => rOutOfFuel

-- How an expression finished: with a value, or by throwing.
\data ExprOut | eVal Value | eExc Value

-- How an argument list finished: all values, or the first throw.
\data ArgsOut | aVals (Array Value) | aExc Value

-- How a statement finished (ClightBigstep's `outcome`, Java-specialised: no
-- break, no continue -- `JStmt` has no loop and no switch -- plus a throw).
--
-- `oNormal` carries the environment out, because `jLocal` extends the scope of
-- the statements after it.
\data StmtOut | oNormal Env | oReturn Value | oExcS Value

-- ---------------------------------------------------------------------------
-- Small helpers. Spelled out rather than imported, so that no import shadows
-- String's `++` (LambdaBox.ard does the same).
-- ---------------------------------------------------------------------------

\func nthArr {A : \Type} (n : Nat) (xs : Array A) : Maybe A \elim n, xs
  | _, nil => nothing
  | 0, x :: _ => just x
  | suc n, _ :: xs => nthArr n xs

\func snocArr {A : \Type} (xs : Array A) (y : A) : Array A \elim xs
  | nil => y :: nil
  | x :: xs => x :: snocArr xs y

\func natEq (m n : Nat) : Bool \elim m, n
  | 0, 0 => true
  | 0, suc _ => false
  | suc _, 0 => false
  | suc m, suc n => natEq m n

\func lookupVar (env : Env) (x : JIdent) : Maybe Value \elim env
  | nil => nothing
  | e :: env => \case e.1 == x \with {
    | true => just e.2
    | false => lookupVar env x
  }

-- Binding shadows by prepending, and lookup scans from the head, so the newest
-- binding wins. Shadowing cannot actually happen in generated code (names are
-- unique by NodePathUnique.ard's lemma), which is a property of the GENERATOR;
-- the semantics does not rely on it.
\func bindVar (env : Env) (x : JIdent) (v : Value) : Env => (x, v) :: env

-- Find a method of a `fix` local class by name.
\func lookupClassMethod (ms : Array (\Sigma JIdent JIdent (Array JStmt))) (nm : JIdent)
  : Maybe (\Sigma JIdent (Array JStmt)) \elim ms
  | nil => nothing
  | m :: ms => \case m.1 == nm \with {
    | true => just (m.2, m.3)
    | false => lookupClassMethod ms nm
  }

-- ---------------------------------------------------------------------------
-- The runtime interface
--
-- `runtime/Rt.java` is hand-written Java using interfaces, nested classes,
-- instance fields, `instanceof`, loops, real arithmetic, generics and `Thread`
-- -- none of which is in this fragment. It is therefore NOT modelled. It is a
-- PARAMETER, and this class is its contract: CompCert's treatment of
-- `external_call`, and Malfunction's of OCaml primitives.
--
-- Two consequences worth stating: the correctness theorem quantifies over
-- `RtSpec`, so it does not depend on Rt's arithmetic being right -- Rt's
-- obligations become an explicit hypothesis rather than a silent assumption --
-- and writing `builtinArity` down IS the fix for the `Rt.curry` class of bug.
--
-- Anything an instance does not cover is `nothing`, hence `rStuck`: a named gap
-- rather than a wrong answer.
--
-- `builtinRun` returns a `Value` and no store, unlike the earlier version, where
-- it had to thread one because a primitive returning `Rt.TRUE`/`Rt.FALSE`
-- allocates a `Data` whose fields lived in the heap. With fields as values there
-- is nothing to allocate.
\class RtSpec
  -- The value of the field `Rt.<name>`: `PRIM_ADD_LONG`, `NAT_SUB_LONG`, ...
  -- (`Rt.BOX` is not here: `jBox` is a node of its own.)
  | rtField : JIdent -> Maybe Value
  -- How many arguments `Rt.<name>` collects before it computes.
  | builtinArity : JIdent -> Maybe Nat
  -- Run a saturated builtin; the array has length `builtinArity name`.
  | builtinRun : JIdent -> Array Value -> Res Value
  -- A static method of the runtime called by name: `Rt.unbound`, `Rt.freeVar`,
  -- `Rt.noBranch` (each throws, by construction), `Long.valueOf` (the identity
  -- on a boxed long). An `ExprOut`, so that an instance can say "this throws"
  -- without the evaluator knowing which members those are -- the same division
  -- `ToJava.ard` keeps, where no runtime member is named in the generator.
  | rtStaticCall : JQIdent -> Array Value -> Maybe (Res ExprOut)

\import Data.Bool
\import Data.Maybe
\import Data.String
\import JavaAst
\import JavaValue
\import Set

-- =============================================================================
-- Formal semantics of the Java fragment: a functional big-step evaluator.
--
-- `JavaAst.ard` defines the SYNTAX of the fragment we commit to generating, and
-- says of itself that it "is what a future semantics and correctness statement
-- are given for". This module is that semantics. Nothing in the compiler imports
-- it -- it is a specification, not a pass -- so a normal compile never
-- typechecks it (`arend arend.yaml JavaEval` does).
--
-- WHY A FUNCTION AND NOT A RELATION. There is no upstream to transcribe: no
-- existing formalisation is the semantics of THIS fragment (unlike the λ□ side,
-- where MetaRocq's `EWcbvEval.eval` is the oracle). So both oracles have to be
-- manufactured, and both want a function: a JLS citation per rule in place of an
-- upstream rule name, and an EXECUTABLE evaluator, so the semantics can be run
-- on generated programs and compared against `javac` + `java`. A relation cannot
-- be run. This is Owens-Myreen-Kumar-Tan's functional big-step style (ESOP
-- 2016), as used by CakeML: a recursive interpreter made total by a decreasing
-- clock, with a timeout result, where divergence is "times out for every clock".
-- `JEval` at the bottom recovers a relation from the function, for a theorem
-- statement. Determinism costs nothing: Java fixes evaluation order left to
-- right (JLS 15.7), so none of Csem.v's reduction-context machinery is needed.
--
-- NO STORE, and hence no rule that depends on WHEN something is read: see the
-- header of JavaValue.ard. This is the semantic payoff of the local-class `fix`
-- and of `case` being an expression.
--
-- WHAT IS AND IS NOT MODELLED. Every constructor of `JExpr`, `JStmt`, `JType`
-- and `JMember` has a clause. The fragment is closed by construction -- the
-- generator can only emit what those constructors allow -- so "unmodelled Java
-- features" cannot appear in the input. What can still affect a real run is
-- outside this function, and is named:
--
--   * `JavaPrint.ard` turns this AST into text and is TRUSTED, in the same sense
--     as CompCert's `printClight.ml`. Its documented gap is that `jStringLit` is
--     not escaped.
--   * `runtime/Rt.java` is a parameter, `RtSpec` (JavaValue.ard).
--
-- THE OBSERVABLE of a generated program is the value its entry method returns
-- (`compileBody`'s `body`, passed to `runClass` by name -- the fragment has no
-- entry point and emits no `System.out.println`, so there is no output
-- component to model). An uncaught exception is a distinct, observable outcome,
-- not a stuck state.
--
-- FOUR NODES THE GENERATOR NEVER EMITS are `rStuck` rather than modelled, each
-- marked at its clause: `jField` on a non-`Rt` receiver, `jNew` of `tObject`/
-- `tFn`/`tData`, `jInvoke` with other than one argument, and `jCallStatic` of a
-- generated method with arguments (every generated method is zero-argument).
-- They are unreachable for output of `ToJava.ard`, and `rStuck` says exactly
-- that: this semantics does not define them.
-- =============================================================================

-- ---------------------------------------------------------------------------
-- Class-level lookup. One flat method table over the single generated class,
-- as every comparable formalisation does it (Featherweight Java's `CT`, Jinja's
-- `class P C`, Clight's `prog_defs`, Malfunction's global bindings).
-- ---------------------------------------------------------------------------

\func lookupMethodIn (ms : Array JMember) (nm : JIdent) : Maybe JMethod \elim ms
  | nil => nothing
  | jMethod m :: ms => \case JMethod.mName {m} == nm \with {
    | true => just m
    | false => lookupMethodIn ms nm
  }
  | jMemberComment _ :: ms => lookupMethodIn ms nm

\func lookupMethod (cls : JClass) (nm : JIdent) : Maybe JMethod =>
  lookupMethodIn (JClass.classMembers {cls}) nm

-- ---------------------------------------------------------------------------
-- Casts. JLS 5.5 / 15.16: a cast to a reference type checks at run time and
-- throws `ClassCastException` on failure.
--
-- The fragment casts for two reasons only -- to call `apply` on a value typed
-- `Object` (`jApply` spells its own cast) and to read a `Data`'s tag or field --
-- so this is the whole of its type discipline.
-- ---------------------------------------------------------------------------

\func excCCE : Value => vExcObj "java.lang.ClassCastException" "cast failed"

\func excAIOOBE : Value => vExcObj "java.lang.ArrayIndexOutOfBoundsException" "index"

\func castOk (t : JType) (v : Value) : Bool \elim t
  -- Every value of the fragment is an `Object`.
  | tObject => true
  -- `Rt.Fn`: a closure, or a runtime constant that is one.
  | tFn => \case v \with {
    | vClos _ _ _ => true
    | vBuiltin _ _ => true
    | _ => false
  }
  | tData => \case v \with {
    | vData _ _ => true
    | _ => false
  }
  -- A named class: a `fix` local class instance, or an exception object.
  | tClass q => \case v \with {
    | vObj c _ _ => c == q
    | vExcObj c _ => c == q
    | _ => false
  }

-- ---------------------------------------------------------------------------
-- The evaluator.
--
-- Fuel (`n`) is the first `\elim` argument and strictly decreases at every
-- recursive call, in every direction of the mutual cycle, so termination is
-- structural on it -- which is also why `ToJava.ard`'s "recurse over arrays
-- inline" discipline does not transfer: `evalArgs` may be an ordinary helper,
-- since it recurses on fuel like everything else.
-- ---------------------------------------------------------------------------

\func evalExpr (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (e : JExpr)
  : Res ExprOut \elim n, e
  | 0, _ => rOutOfFuel

  -- Literals (JLS 3.10) and the erased-value atom.
  | suc _, jStringLit s => rOk (eVal (vStr s))
  | suc _, jIntLit k => rOk (eVal (vInt k))
  | suc _, jLongLit i => rOk (eVal (vLong i))
  | suc _, jBox => rOk (eVal vBox)

  -- A local or a parameter. Unbound is `rStuck`: `javac` would reject the
  -- program (JLS 6.5.6.1), and generated code cannot contain it -- the
  -- generator binds every name it reads.
  | suc _, jVar x => \case lookupVar env x \with {
    | nothing => rStuck
    | just v => rOk (eVal v)
  }

  -- `Rt` as a receiver. The generator only emits `jStatic runtimeClassName`.
  | suc _, jStatic q => rOk (eVal (vStaticRef q))

  -- A closure. The environment is captured BY VALUE, now (JLS 15.9.5, 4.12.4).
  | suc _, jClosure p body => rOk (eVal (vClos p body env))

  -- `C.this` from inside a nested anonymous class. `jLocalClass` bound `C` to
  -- the instance, and a method call re-binds it (see `jInvoke`), so this is a
  -- lookup rather than a rule about enclosing instances.
  | suc _, jQualThis q => \case lookupVar env q \with {
    | just (vObj c ms cenv) => rOk (eVal (vObj c ms cenv))
    | _ => rStuck
  }

  -- `e.f`. Only ever a field of `Rt` (`Rt.PRIM_ADD_LONG`, ...): the tag and
  -- field reads that used to go through here are `jTagEq`/`jDataField` now, so
  -- ANY OTHER RECEIVER IS UNREACHABLE for generated code, hence stuck.
  | suc n, jField recv f =>
    bindRes (evalExpr rt cls n env recv) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal (vStaticRef _) => \case rtField {rt} f \with {
        | nothing => rStuck                      -- an Rt member no instance covers
        | just v => rOk (eVal v)
      }
      | eVal _ => rStuck
    })

  -- `(T)e`. JLS 5.5.
  | suc n, jCast t e =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal v => \case castOk t v \with {
        | true => rOk (eVal v)
        | false => rOk (eExc excCCE)
      }
    })

  -- `((Rt.Fn)(f)).apply(x)`: λ□ application. The cast is part of the node (see
  -- JavaAst.ard's RUNTIME ABI), so it is checked here rather than by a `jCast`.
  | suc n, jApply f a =>
    bindRes (evalExpr rt cls n env f) (\lam of => \case of \with {
      | eExc ev => rOk (eExc ev)
      | eVal fv => \case castOk tFn fv \with {
        | false => rOk (eExc excCCE)
        | true =>
          bindRes (evalExpr rt cls n env a) (\lam oa => \case oa \with {
            | eExc ev => rOk (eExc ev)
            | eVal av => applyVal rt cls n fv av
          })
      }
    })

  -- `recv.m(arg)`: a call to a method of a `fix` local class, the fragment's
  -- only non-`apply` virtual call. Exactly one argument, by construction.
  | suc n, jInvoke recv m args =>
    bindRes (evalExpr rt cls n env recv) (\lam orv => \case orv \with {
      | eExc ev => rOk (eExc ev)
      | eVal rv =>
        bindRes (evalArgs rt cls n env args) (\lam oas => \case oas \with {
          | aExc ev => rOk (eExc ev)
          | aVals vs => invokeMethod rt cls n rv m vs
        })
    })

  -- `q(args)`: a method of the generated class, or a static of the runtime.
  | suc n, jCallStatic q args =>
    bindRes (evalArgs rt cls n env args) (\lam oas => \case oas \with {
      | aExc ev => rOk (eExc ev)
      | aVals vs => callStatic rt cls n q vs
    })

  -- `new T(args)`.
  | suc n, jNew t args =>
    bindRes (evalArgs rt cls n env args) (\lam oas => \case oas \with {
      | aExc ev => rOk (eExc ev)
      | aVals vs => newObject env t vs
    })

  -- `new Rt.Data(tag, new Object[]{ .. })`: a constructor application. Nothing
  -- is allocated -- the fields ARE the values (JavaValue.ard, NO STORE).
  | suc n, jDataNew tag args =>
    bindRes (evalArgs rt cls n env args) (\lam oas => \case oas \with {
      | aExc ev => rOk (eExc ev)
      | aVals vs => rOk (eVal (vData tag vs))
    })

  -- `d.tag == k` (JLS 15.21.1): is this value the k-th constructor? The
  -- receiver is always the `Rt.Data`-typed local a `case` binds, so a
  -- non-`Data` cannot arise.
  | suc n, jTagEq d k =>
    bindRes (evalExpr rt cls n env d) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal (vData tg _) => rOk (eVal (vBool (natEq tg k)))
      | eVal _ => rStuck
    })

  -- `d.fields[i]`. JLS 10.4: an out-of-range index throws. For a well-formed λ□
  -- term the index is in range (it is a field of the matched constructor), so
  -- the throw is unreachable rather than impossible -- worth modelling exactly
  -- because a generator bug would land here.
  | suc n, jDataField d i =>
    bindRes (evalExpr rt cls n env d) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal (vData _ fs) => \case nthArr i fs \with {
        | just v => rOk (eVal v)
        | nothing => rOk (eExc excAIOOBE)
      }
      | eVal _ => rStuck
    })

  -- `(c ? a : b)`. JLS 15.25: the condition is evaluated, then EXACTLY ONE of
  -- the two arms. This is the whole of λ□'s `iota` rule, and the reason a
  -- branch of a `case` may cost nothing when it is not selected.
  | suc n, jCond c a b =>
    bindRes (evalExpr rt cls n env c) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal (vBool true) => evalExpr rt cls n env a
      | eVal (vBool false) => evalExpr rt cls n env b
      | eVal _ => rStuck
    })

-- Arguments, left to right (JLS 15.12.4.2); the first throw stops the list.
\func evalArgs (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (es : Array JExpr)
  : Res ArgsOut \elim n, es
  | 0, _ => rOutOfFuel
  | suc _, nil => rOk (aVals nil)
  | suc n, e :: es =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (aExc ev)
      | eVal v =>
        bindRes (evalArgs rt cls n env es) (\lam os => \case os \with {
          | aExc ev => rOk (aExc ev)
          | aVals vs => rOk (aVals (v :: vs))
        })
    })

-- `apply`. A closure runs its body in the captured environment extended with
-- its parameter; a runtime constant accumulates arguments until it is saturated
-- and then computes (the arity discipline `Rt.curry` got wrong).
--
-- The `Rt.Fn` cast at the call site has already been checked, so a value that is
-- neither is unreachable.
\func applyVal (rt : RtSpec) (cls : JClass) (n : Nat) (f a : Value)
  : Res ExprOut \elim n
  | 0 => rOutOfFuel
  | suc n => \case f \with {
    | vClos p body cenv =>
      bindRes (execStmts rt cls n (bindVar cenv p a) body) (\lam o => \case o \with {
        | oReturn v => rOk (eVal v)
        | oExcS ev => rOk (eExc ev)
        -- `apply` returns `Object`, so falling off the end is not a well-formed
        -- method body (JLS 8.4.7); cf. ClightBigstep's `outcome_result_value`.
        | oNormal _ => rStuck
      })
    | vBuiltin nm got => \case builtinArity {rt} nm \with {
      | nothing => rStuck
      | just k => \case snocArr got a \with {
        | got' => \case natEq got'.len k \with {
          | false => rOk (eVal (vBuiltin nm got'))
          | true => bindRes (builtinRun {rt} nm got') (\lam v => rOk (eVal v))
        }
      }
    }
    | _ => rStuck
  }

-- `recv.f<j>(arg)` on a `fix` local class instance.
--
-- THIS IS WHERE THE KNOT IS TIED. The body runs in the environment captured at
-- the class declaration, extended with the class's own name bound to the
-- receiver and then with the parameter -- so a sibling reached through
-- `C.this.f<i>` finds the same instance, at any depth, without a mutable cell
-- and without an initialization order. That is the letrec rule, and it is what
-- the encoding buys the semantics.
\func invokeMethod (rt : RtSpec) (cls : JClass) (n : Nat) (recv : Value) (m : JIdent) (vs : Array Value)
  : Res ExprOut \elim n
  | 0 => rOutOfFuel
  | suc n => \case recv \with {
    | vObj c ms cenv => \case lookupClassMethod ms m \with {
      | nothing => rStuck
      | just pb => \case vs \with {
        | a :: nil =>
          bindRes (execStmts rt cls n (bindVar (bindVar cenv c (vObj c ms cenv)) pb.1 a) pb.2)
                  (\lam o => \case o \with {
            | oReturn v => rOk (eVal v)
            | oExcS ev => rOk (eExc ev)
            | oNormal _ => rStuck
          })
        -- Every method of a `fix` class is `Object f<j>(Object)`: unreachable.
        | _ => rStuck
      }
    }
    | _ => rStuck
  }

-- `q(args)`: a method of the generated class, else a static of the runtime.
--
-- A generated method body is evaluated in the EMPTY environment: every one is
-- `public static Object <name>()`, so it has no parameters, and a λ□ constant
-- is closed (`compileDecl` compiles it at the root path with `env = nil`).
\func callStatic (rt : RtSpec) (cls : JClass) (n : Nat) (q : JQIdent) (vs : Array Value)
  : Res ExprOut \elim n
  | 0 => rOutOfFuel
  | suc n => \case lookupMethod cls q \with {
    | just mth => \case vs \with {
      | nil =>
        bindRes (execStmts rt cls n nil (JMethod.mBody {mth})) (\lam o => \case o \with {
          | oReturn v => rOk (eVal v)
          | oExcS ev => rOk (eExc ev)
          -- An `Object` method may not fall off the end (JLS 8.4.7).
          | oNormal _ => rStuck
        })
      | _ => rStuck                              -- zero-argument by construction
    }
    -- Not ours: `Rt.unbound`, `Rt.freeVar`, `Rt.noBranch`, `Long.valueOf`. The
    -- instance decides, so this file names no runtime member -- the division
    -- `ToJava.ard` keeps between the generator and `JavaAxioms.ard`.
    | nothing => \case rtStaticCall {rt} q vs \with {
      | nothing => rStuck
      | just r => r
    }
  }

-- `new T(args)` for the two things the generator instantiates: a `fix` local
-- class, and the `RuntimeException` of an unimplemented axiom's stub.
--
-- A local class is looked up rather than built: `jLocalClass` bound the name to
-- the instance, and the instances are indistinguishable (JavaValue.ard, ONE
-- VALUE FOR THE CLASS AND ITS INSTANCES).
\func newObject (env : Env) (t : JType) (vs : Array Value) : Res ExprOut =>
  \case t \with {
    | tClass q => \case lookupVar env q \with {
      | just (vObj c ms cenv) => \case vs \with {
        | nil => rOk (eVal (vObj c ms cenv))
        | _ => rStuck                            -- the class has no constructor
      }
      | _ => \case vs \with {
        | vStr msg :: nil => rOk (eVal (vExcObj q msg))
        | _ => rStuck
      }
    }
    -- `new Object()`/`new Rt.Fn()`/`new Rt.Data()` as such: never emitted
    -- (`jClosure` and `jDataNew` are their own nodes).
    | _ => rStuck
  }

-- ---------------------------------------------------------------------------
-- Statements. A statement list is a sequence of bindings ending in a `jReturn`
-- (JavaAst.ard, STATEMENTS ARE FOR NAMING), so this is a let-chain with two
-- abrupt outcomes.
-- ---------------------------------------------------------------------------

\func execStmt (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (s : JStmt)
  : Res StmtOut \elim n, s
  | 0, _ => rOutOfFuel

  -- No effect at all; it exists so the printer can put a comment on a line.
  | suc _, jComment _ => rOk (oNormal env)

  -- `final T x = e;` -- always final, always initialized, so this is a binding
  -- and nothing else. The declared type is not checked: it is what the printer
  -- spells, and the value is whatever the initializer produced (`javac` checks
  -- the pair, JLS 5.2).
  | suc n, jLocal _ x e =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (oExcS ev)
      | eVal v => rOk (oNormal (bindVar env x v))
    })

  -- `class C { Object f0(Object p){ .. } .. }` declared in a block: the `fix`
  -- knot. Declaring it binds the name to the instance, capturing the
  -- environment at the declaration -- which is what makes the following
  -- `new C()` and every `C.this` inside a method mean the same object.
  | suc _, jLocalClass c ms => rOk (oNormal (bindVar env c (vObj c ms env)))

  | suc n, jThrow e =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (oExcS ev)
      | eVal v => rOk (oExcS v)
    })

  | suc n, jReturn e =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (oExcS ev)
      | eVal v => rOk (oReturn v)
    })

-- An abrupt outcome stops the sequence and propagates; a normal one carries its
-- (possibly extended) environment to the next statement. Falling off the end is
-- `oNormal`, which every caller rejects -- see `applyVal`.
\func execStmts (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (ss : Array JStmt)
  : Res StmtOut \elim n, ss
  | 0, _ => rOutOfFuel
  | suc _, nil => rOk (oNormal env)
  | suc n, s :: ss =>
    bindRes (execStmt rt cls n env s) (\lam o => \case o \with {
      | oReturn v => rOk (oReturn v)
      | oExcS ev => rOk (oExcS ev)
      | oNormal env' => execStmts rt cls n env' ss
    })

-- ---------------------------------------------------------------------------
-- Running a program
--
-- The generated class is a LIBRARY: `compileBody` emits one zero-argument
-- method (`body`) returning the program's value, and no entry point. So the
-- semantics of a generated program is what that method returns, and the entry
-- name is a parameter rather than a constant here -- the generator owns that
-- name (`ToJava.ard`'s `bodyMethodName`), not the semantics.
-- ---------------------------------------------------------------------------

\data RunOut | rvValue Value | rvThrown Value

\func runClass (rt : RtSpec) (cls : JClass) (entry : JIdent) (n : Nat) : Res RunOut =>
  bindRes (callStatic rt cls n entry nil) (\lam o => \case o \with {
    | eVal v => rOk (rvValue v)
    | eExc ev => rOk (rvThrown ev)
  })

-- The relation, recovered from the function: "`cls` runs to `v`" is "there is a
-- clock for which the evaluator says so". This is the right-hand side a
-- correctness statement needs.
\func JEval (rt : RtSpec) (cls : JClass) (entry : JIdent) (v : Value) : \Type =>
  \Sigma (n : Nat) (runClass rt cls entry n = rOk (rvValue v))

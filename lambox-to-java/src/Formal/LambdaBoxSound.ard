\import Arith.Nat
\import Data.Bool
\import Data.Maybe
\import Data.String
\import Formal.LambdaBoxEval
\import Formal.LambdaBoxRun
\import Data.Array (cong_::)
\import Formal.Res
\import Function.Meta ($)
\import LambdaBox
\import Logic
\import Meta
\import Paths
\import Paths.Meta
\import Set
\import StringUtil (nthArr)

-- =============================================================================
-- The oracle is sound: whatever `evalT` computes, the relation derives.
--
--     evalT spec env n t = rOk v  ->  Eval spec env t v
--
-- This is the first of the two obligations `Formal/LambdaBoxRun.ard` states,
-- and the one that matters for the agreement checks: it turns every `bothAgree`
-- instance from "the oracle and the Java semantics agree" into "λ□'S SEMANTICS
-- and the Java semantics agree", because the value the oracle produced is now
-- backed by a derivation of the transcribed relation.
--
-- The other direction (completeness: every derivation is found at some fuel) is
-- not proved here. It is what would let a STUCK oracle result be read as "the
-- relation does not derive anything either"; without it, `rStuck` means only
-- "this function found no rule".
--
-- For comparison, CertiRocq proves the same pair for its own λ□ layer
-- (`LambdaBoxMut/wcbvEval.v`, `Function wcbvEval (tmr:nat)` against `Inductive
-- WcbvEval`): there the completeness direction `WcbvEval_wcbvEval` is proved
-- and the soundness direction `wcbvEval_WcbvEval` is `Admitted` -- the opposite
-- half from the one below.
--
-- SHAPE. Induction is on FUEL, in the same clause order as the oracle, so each
-- case reads next to the code it is about. Everything else is inversion:
-- `bindRes-inv` for the sequencing, `rOk-inj` for the results, and a `\case`
-- with `\as`/`idp` for each scrutinee the oracle tests -- which is exactly the
-- premise list of the corresponding rule.
-- =============================================================================

-- ---------------------------------------------------------------------------
-- Inversion of `Res`.
-- ---------------------------------------------------------------------------

-- "is a value", as a type, so that the two impossible outcomes are refutable.
\func ResOk {A : \Type} (r : Res A) : \Prop
  | rOk _ => \Sigma
  | rStuck => Empty
  | rOutOfFuel => Empty

\func stuck/=ok {A : \Type} {v : A} (p : rStuck = rOk v) : Empty
  => transport ResOk (inv p) ()

\func fuel/=ok {A : \Type} {v : A} (p : rOutOfFuel = rOk v) : Empty
  => transport ResOk (inv p) ()

\func unRes {A : \Type} (d : A) (r : Res A) : A
  | d, rOk a => a
  | d, rStuck => d
  | d, rOutOfFuel => d

\func rOk-inj {A : \Type} {a b : A} (p : rOk a = rOk b) : a = b => pmap (unRes a) p

-- The workhorse: a sequenced computation that produced a value did so by both
-- halves producing one. Every clause of the oracle goes through this.
\func bindRes-inv {A B : \Type} (r : Res A) {f : A -> Res B} {v : B} (p : bindRes r f = rOk v)
  : \Sigma (a : A) (r = rOk a) (f a = rOk v) \elim r
  | rOk a => (a, idp, p)
  | rStuck => absurd (stuck/=ok p)
  | rOutOfFuel => absurd (fuel/=ok p)

-- A Bool test the oracle made and passed, as the equation the rule wants.
\lemma fromEqB {A : DecSet} {a b : A} (q : (a == b) = true) : a = b => ==_= (So.toSo q)

-- The oracle's identity tests, as the equations the rules want. `indEq` is the
-- only place the oracle compares structured data, and it bottoms out in
-- `Set.==` on strings and numbers, so these four are one induction each.
\lemma dirPathEq-eq {a b : DirPath} (q : dirPathEq a b = true) : a = b \elim a, b
  | nil, nil => idp
  | nil, y :: b => absurd (true/=false (inv q))
  | x :: a, nil => absurd (true/=false (inv q))
  | x :: a, y :: b => \case and.toSigma q \with {
    | (q1, q2) => cong_:: (fromEqB q1) (dirPathEq-eq q2)
  }

\lemma modPathEq-eq {a b : ModPath} (q : modPathEq a b = true) : a = b \elim a, b
  | mpFile p, mpFile p' => pmap mpFile (dirPathEq-eq q)
  | mpFile _, mpBound _ _ _ => absurd (true/=false (inv q))
  | mpFile _, mpDot _ _ => absurd (true/=false (inv q))
  | mpBound _ _ _, mpFile _ => absurd (true/=false (inv q))
  | mpBound p x m, mpBound p' y n => \case and.toSigma q \with {
    | (q1, q2) => \case and.toSigma q1 \with {
      | (q3, q4) => path (\lam i => mpBound (dirPathEq-eq q3 i) (fromEqB q4 i) (fromEqB q2 i))
    }
  }
  | mpBound _ _ _, mpDot _ _ => absurd (true/=false (inv q))
  | mpDot _ _, mpFile _ => absurd (true/=false (inv q))
  | mpDot _ _, mpBound _ _ _ => absurd (true/=false (inv q))
  | mpDot p x, mpDot p' y => \case and.toSigma q \with {
    | (q1, q2) => path (\lam i => mpDot (modPathEq-eq q1 i) (fromEqB q2 i))
  }

\lemma kernameEq-eq {a b : Kername} (q : kernameEq a b = true) : a = b
  => \case and.toSigma q \with {
    | (q1, q2) => path (\lam i => \new Kername (modPathEq-eq q1 i) (fromEqB q2 i))
  }

\lemma indEq-eq {a b : InductiveId} (q : indEq a b = true) : a = b
  => \case and.toSigma q \with {
    | (q1, q2) => path (\lam i => \new InductiveId (kernameEq-eq q1 i) (fromEqB q2 i))
  }

-- The pointwise premise of `evalConstruct`, one step. A definition of its own
-- rather than a `\case` inside the caller's `\let`: the elaborator handles the
-- eliminated index cleanly here and reports an unsolvable `Fin` mismatch there.
\func consPointwise (spec : LBSpec) {env : GlobalDeclarations} (x xv : LBTerm) (xs : Array LBTerm)
                    (xvs : Array LBTerm xs.len)
                    (e : Eval spec env x xv) (es : \Pi (i : Fin xs.len) -> Eval spec env (xs i) (xvs i))
                    (i : Fin (suc xs.len))
  : Eval spec env ((x :: xs) i) ((xv :: xvs) i) \elim i
  | 0 => e
  | suc j => es j

-- ---------------------------------------------------------------------------
-- Soundness, by induction on fuel.
--
-- `\elim n, t` in the oracle's own clause order, so that `evalT spec env n t`
-- reduces in each case and `p` is an equation about the clause's body.
-- ---------------------------------------------------------------------------

\func evalT-sound (spec : LBSpec) {env : GlobalDeclarations} (n : Nat) {t v : LBTerm}
                  (p : evalT spec env n t = rOk v) : Eval spec env t v \elim n, t
  | 0, _ => absurd (fuel/=ok p)

  -- The atoms: the oracle returned the term itself, and the rule says the value
  -- IS the term.
  | suc _, box => evalAtomBox (inv (rOk-inj p))
  | suc _, lambda na b => evalAtomLambda (inv (rOk-inj p))
  | suc _, fix defs idx => evalAtomFix (inv (rOk-inj p))
  | suc _, prim pv => evalPrim (inv (rOk-inj p))

  -- No rule, and the oracle agrees: nothing to derive.
  | suc _, bvar _ => absurd (stuck/=ok p)
  | suc _, fvar _ => absurd (stuck/=ok p)

  -- `evalDelta`: the two lookups the oracle made ARE the rule's two premises.
  -- With no body there is a third lookup and a second rule, `evalAxiom`: the
  -- three tests the oracle made in order are the three premises it asks for.
  | suc n, const kn =>
    \case lookupConstant env kn \as lc, idp : lookupConstant env kn = lc \with {
      | nothing, q => rewrite q at p $ absurd (stuck/=ok p)
      | just cb, q => rewrite q at p $
        \case ConstantBody.cstBody {cb} \as body?, idp : ConstantBody.cstBody {cb} = body? \with {
          | nothing, q2 => rewrite q2 at p $
            \case axiomArity {spec} kn \as ar, idp : axiomArity {spec} kn = ar \with {
              -- An axiom the oracle does not know: stuck, and no rule to derive.
              | nothing, q3 => rewrite q3 at p $ absurd (stuck/=ok p)
              | just arity, q3 => rewrite q3 at p $ evalAxiom q q2 q3 (inv (rOk-inj p))
            }
          | just body, q2 => evalDelta q q2 (evalT-sound spec n (rewrite q2 at p $ p))
        }
    }

  -- `evalZeta`: the sequencing is the rule's two premises, in order.
  | suc n, letIn na b0 b1 =>
    \let q => bindRes-inv (evalT spec env n b0) p
    \in evalZeta (evalT-sound spec n q.2) (evalT-sound spec n q.3)

  -- The four application rules are `applyT`'s business; here we only supply the
  -- derivations for the function and the argument.
  | suc n, app f a =>
    \let | q => bindRes-inv (evalT spec env n f) p
         | r => bindRes-inv (evalT spec env n a) q.3
    \in applyT-sound spec n (evalT-sound spec n q.2) (evalT-sound spec n r.2) r.3
  -- `evalConstruct`: the arity lookup and the length test are the rule's first
  -- two premises, the recursive call its pointwise one.
  | suc n, construct ind c args =>
    \case constructorArity env ind c \as ca, idp : constructorArity env ind c = ca \with {
      | nothing, q => rewrite q at p $ absurd (stuck/=ok p)
      | just arity, q => rewrite q at p $
        \case (args.len == arity) \as b, idp : (args.len == arity) = b \with {
          | false, q2 => rewrite q2 at p $ absurd (stuck/=ok p)
          | true, q2 => rewrite q2 at p $
            \case bindRes-inv {Array LBTerm args.len} (evalArgsT spec env n args) p \with {
              | (vs, e1, e2) =>
                evalConstruct q (fromEqB q2) (evalArgsT-sound spec n args vs e1) (inv (rOk-inj e2))
            }
        }
    }
  -- `evalIota`. The oracle's four-way Bool test is the rule's four premises,
  -- and `indEq-eq` is what turns its identity check back into the equation the
  -- rule states by SHARING the variable `ind`.
  | suc n, case ind npars discr brs =>
    \case bindRes-inv (evalT spec env n discr) p \with {
      | (dv, e1, e2) => \case \elim dv, \elim e1, \elim e2 \with {
        | construct ind' c cargs, e1, e2 =>
          \case constructorInfo env ind c \as ci, idp : constructorInfo env ind c = ci \with {
            | nothing, q => rewrite q at e2 $ absurd (stuck/=ok e2)
            | just (true, np', na), q => rewrite q at e2 $ absurd (stuck/=ok e2)
            | just (false, np', na), q => rewrite q at e2 $
              \case nthArr c brs \as nb, idp : nthArr c brs = nb \with {
                | nothing, q2 => rewrite q2 at e2 $ absurd (stuck/=ok e2)
                | just br, q2 => rewrite q2 at e2 $
                  \case indEq ind' ind and (npars == np') and (cargs.len == npars Nat.+ na)
                          and ((dropArr npars cargs).len == (br.1).len) \as bb,
                        idp : indEq ind' ind and (npars == np') and (cargs.len == npars Nat.+ na)
                                and ((dropArr npars cargs).len == (br.1).len) = bb \with {
                    | false, q3 => rewrite q3 at e2 $ absurd (stuck/=ok e2)
                    | true, q3 => rewrite q3 at e2 $
                      \case and.toSigma q3 \with {
                        | (q4, c4) => \case and.toSigma q4 \with {
                          | (q5, c3) => \case and.toSigma q5 \with {
                            | (c1, c2) =>
                              evalIota (transport (\lam ii => Eval spec env discr (construct ii c cargs))
                                                  (indEq-eq c1) (evalT-sound spec n e1))
                                       -- an explicit motive, because `rewrite`
                                       -- here would also hit the rule's still
                                       -- unsolved `nargs` and unify it with
                                       -- `npars`.
                                       (transport (\lam x => constructorInfo env ind c
                                                             = just (false, x, na))
                                                  (inv (fromEqB c2)) q)
                                       q2
                                       (fromEqB c3)
                                       (fromEqB c4)
                                       (evalT-sound spec n e2)
                          }
                        }
                      }
                  }
              }
          }
        -- Every other value: the oracle has no rule and neither has the relation.
        | box, e1, e2 => absurd (stuck/=ok e2)
        | bvar k, e1, e2 => absurd (stuck/=ok e2)
        | fvar x, e1, e2 => absurd (stuck/=ok e2)
        | lambda na b, e1, e2 => absurd (stuck/=ok e2)
        | letIn na b0 b1, e1, e2 => absurd (stuck/=ok e2)
        | app f a, e1, e2 => absurd (stuck/=ok e2)
        | const kn, e1, e2 => absurd (stuck/=ok e2)
        | case ind2 np2 d2 brs2, e1, e2 => absurd (stuck/=ok e2)
        | proj pi2 d2, e1, e2 => absurd (stuck/=ok e2)
        | fix defs idx, e1, e2 => absurd (stuck/=ok e2)
        | prim pv, e1, e2 => absurd (stuck/=ok e2)
      }
    }
  -- `evalProj`, the same shape with three premises and the constructor index
  -- pinned to 0 (a projection is out of a single-constructor block).
  | suc n, proj pi discr =>
    \case bindRes-inv (evalT spec env n discr) p \with {
      | (dv, e1, e2) => \case \elim dv, \elim e1, \elim e2 \with {
        | construct ind' 0 cargs, e1, e2 =>
          \case constructorInfo env (ProjectionInfo.projIndType {pi}) 0 \as ci,
                idp : constructorInfo env (ProjectionInfo.projIndType {pi}) 0 = ci \with {
            | nothing, q => rewrite q at e2 $ absurd (stuck/=ok e2)
            | just (true, np, na), q => rewrite q at e2 $ absurd (stuck/=ok e2)
            | just (false, np, na), q => rewrite q at e2 $
              \case indEq ind' (ProjectionInfo.projIndType {pi})
                      and (np == ProjectionInfo.projParamCount {pi})
                      and (cargs.len == np Nat.+ na) \as bb,
                    idp : indEq ind' (ProjectionInfo.projIndType {pi})
                            and (np == ProjectionInfo.projParamCount {pi})
                            and (cargs.len == np Nat.+ na) = bb \with {
                | false, q2 => rewrite q2 at e2 $ absurd (stuck/=ok e2)
                | true, q2 => rewrite q2 at e2 $
                  \case nthArr (ProjectionInfo.projParamCount {pi}
                                Nat.+ ProjectionInfo.projFieldIdx {pi}) cargs \as fa,
                        idp : nthArr (ProjectionInfo.projParamCount {pi}
                                      Nat.+ ProjectionInfo.projFieldIdx {pi}) cargs = fa \with {
                    | nothing, q3 => rewrite q3 at e2 $ absurd (stuck/=ok e2)
                    | just a, q3 => rewrite q3 at e2 $
                      \case and.toSigma q2 \with {
                        | (q4, c3) => \case and.toSigma q4 \with {
                          | (c1, c2) =>
                            evalProj (transport (\lam ii => Eval spec env discr (construct ii 0 cargs))
                                                (indEq-eq c1) (evalT-sound spec n e1))
                                     (transport (\lam x => constructorInfo env
                                                             (ProjectionInfo.projIndType {pi}) 0
                                                           = just (false, x, na))
                                                (fromEqB c2) q)
                                     (transport (\lam x => cargs.len = x Nat.+ na)
                                                (fromEqB c2) (fromEqB c3))
                                     q3
                                     (evalT-sound spec n e2)
                        }
                      }
                  }
              }
          }
        | construct ind' (suc k) cargs, e1, e2 => absurd (stuck/=ok e2)
        | box, e1, e2 => absurd (stuck/=ok e2)
        | bvar k, e1, e2 => absurd (stuck/=ok e2)
        | fvar x, e1, e2 => absurd (stuck/=ok e2)
        | lambda na b, e1, e2 => absurd (stuck/=ok e2)
        | letIn na b0 b1, e1, e2 => absurd (stuck/=ok e2)
        | app f a, e1, e2 => absurd (stuck/=ok e2)
        | const kn, e1, e2 => absurd (stuck/=ok e2)
        | case ind2 np2 d2 brs2, e1, e2 => absurd (stuck/=ok e2)
        | proj pi2 d2, e1, e2 => absurd (stuck/=ok e2)
        | fix defs idx, e1, e2 => absurd (stuck/=ok e2)
        | prim pv, e1, e2 => absurd (stuck/=ok e2)
      }
    }

-- The application rules, given derivations for the two halves.
\func applyT-sound (spec : LBSpec) {env : GlobalDeclarations} (n : Nat) {f a fv av v : LBTerm}
                   (ef : Eval spec env f fv) (ea : Eval spec env a av)
                   (p : applyT spec env n fv av = rOk v) : Eval spec env (app f a) v \elim n
  | 0 => absurd (fuel/=ok p)
  | suc n => \case \elim fv, \elim ef, \elim p \with {
    -- `evalBox`.
    | box, ef, p => evalBox (inv (rOk-inj p)) ef ea
    -- `evalBeta`.
    | lambda na b, ef, p => evalBeta ef ea (evalT-sound spec n p)
    -- `evalFix`, unguarded.
    | fix defs idx, ef, p =>
      \case cunfoldFix defs idx \as cu, idp : cunfoldFix defs idx = cu \with {
        | nothing, q => rewrite q at p $ absurd (stuck/=ok p)
        | just (narg, fn), q => rewrite q at p $ evalFix ef q ea (evalT-sound spec n p)
      }
    -- `evalAppCong`, where the oracle's `appCongOk` test is the rule's premise.
    -- For most values it computes to `true` outright; for an application it
    -- depends on the spine, and for the two that can start a redex it is
    -- `false`, so there is nothing to derive.
    -- FOR THESE FIVE THE ORACLE'S EXCLUSION IS `idp`. `axiomSat` demands a
    -- `const` at the head of the application spine, and none of these is one or
    -- has one, so `axiomSpine` reduces to `nothing` without knowing anything
    -- about `spec` -- the runner's dispatch takes its `nothing` branch by
    -- computation, and `evalAppCong`'s new premise is discharged the same way.
    | bvar k, ef, p => evalAppCong ef idp ea idp (inv (rOk-inj p))
    | fvar x, ef, p => evalAppCong ef idp ea idp (inv (rOk-inj p))
    | letIn na b0 b1, ef, p => evalAppCong ef idp ea idp (inv (rOk-inj p))
    | case ind npars discr brs, ef, p => evalAppCong ef idp ea idp (inv (rOk-inj p))
    | proj pi discr, ef, p => evalAppCong ef idp ea idp (inv (rOk-inj p))

    -- THE TWO SHAPES A SATURATED AXIOM CALL CAN HAVE: the function value is the
    -- axiom itself (a unary one, applied here), or an application still
    -- collecting arguments whose spine head is the axiom. Both go through the
    -- same three steps as the runner -- is it saturated, did the oracle compute,
    -- and is what it computed the value we were given.
    | const kn, ef, p =>
      \case axiomSat spec (app (const kn) av) \as sat,
            idp : axiomSat spec (app (const kn) av) = sat \with {
        | nothing, q => rewrite q at p $ evalAppCong ef idp ea q (inv (rOk-inj p))
        | just (kn', args), q => rewrite q at p $
          \case axiomRun {spec} kn' args \as r, idp : axiomRun {spec} kn' args = r \with {
            -- The oracle declined: stuck, and `evalAppCong` is NOT available
            -- (its premise wants `axiomSat = nothing`, and `q` says otherwise),
            -- which is the asymmetry the runner's comment is about.
            | nothing, q2 => rewrite q2 at p $ absurd (stuck/=ok p)
            | just w, q2 => evalAxiomApp kn' args ef ea q
                                         (q2 *> pmap just (rOk-inj (rewrite q2 at p $ p)))
          }
      }
    | app g b, ef, p =>
      \case axiomSat spec (app (app g b) av) \as sat,
            idp : axiomSat spec (app (app g b) av) = sat \with {
        | just (kn, args), q => rewrite q at p $
          \case axiomRun {spec} kn args \as r, idp : axiomRun {spec} kn args = r \with {
            | nothing, q2 => rewrite q2 at p $ absurd (stuck/=ok p)
            | just w, q2 => evalAxiomApp kn args ef ea q
                                         (q2 *> pmap just (rOk-inj (rewrite q2 at p $ p)))
          }
        | nothing, q => rewrite q at p $
          \case appCongOkSpine g \as sp, idp : appCongOkSpine g = sp \with {
            | false, q2 => rewrite q2 at p $ absurd (stuck/=ok p)
            | true, q2 => rewrite q2 at p $ evalAppCong ef q2 ea q (inv (rOk-inj p))
          }
      }
    | construct ind c cargs, ef, p => absurd (stuck/=ok p)
    | prim pv, ef, p => absurd (stuck/=ok p)
  }

-- The fields of a constructor, pointwise. The result is length-indexed exactly
-- so that this statement is the premise `evalConstruct` asks for.
-- `xs` and `vs` are EXPLICIT: left implicit, the elaborator has to solve an
-- array from `Fin xs.len` in the result type, which is higher-order, and it
-- reports the failure as a mismatch between two identical-looking `Fin`s.
\func evalArgsT-sound (spec : LBSpec) {env : GlobalDeclarations} (n : Nat) (xs : Array LBTerm)
                      (vs : Array LBTerm xs.len) (p : evalArgsT spec env n xs = rOk vs)
  : \Pi (i : Fin xs.len) -> Eval spec env (xs i) (vs i) \elim n, xs
  | 0, _ => absurd (fuel/=ok p)
  | suc n, nil => \lam i => \case i
  -- `m` is the FUEL; the array's tail length is its own variable.
  | suc m, x :: xs =>
    \case bindRes-inv (evalT spec env m x) p \with {
      | (xv, e1, e2) => \case bindRes-inv {Array LBTerm xs.len} (evalArgsT spec env m xs) e2 \with {
        | (xvs, e3, e4) =>
          -- The equation is used POINTWISE (`pmap (__ i)`) rather than by
          -- rewriting the array inside the `\Pi`: abstracting an array under a
          -- binder leaves the elaborator comparing two `Fin`s it prints
          -- identically and cannot unify.
          \lam i => transport (Eval spec env ((x :: xs) i))
                              (pmap (\lam (w : Array LBTerm (suc xs.len)) => w i) (rOk-inj e4))
                              (consPointwise spec x xv xs xvs (evalT-sound spec m e1)
                                             (evalArgsT-sound spec m xs xvs e3) i)
      }
    }

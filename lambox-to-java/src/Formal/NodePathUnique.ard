\import Algebra.Meta
\import Arith.Fin.Order
\import Arith.Nat
\import Data.Array
\import Data.Bool
\import Data.Maybe
\import Data.String (Byte, String, stringExt)
\import Logic.Meta
\import NodePath
\import Order.Biordered
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta
\import Set
\import StringUtil

-- =============================================================================
-- Generated names are unique: `renderName` is injective.
--
-- This is the one lemma the naming scheme rests on (see NodePath.ard). It says
-- two generated identifiers are equal only if they come from the same node and
-- the same kind -- so names cannot collide however deep the path, however large
-- an index, and whatever letters a future selector picks. What used to be a
-- convention spread over `ToJava.ard` is a proof over two datatypes here.
--
-- IT IS NOT the whole uniqueness argument. It reduces "no two names collide" to
-- "no two naming SITES share a (kind, path) pair", which is a property of the
-- GENERATOR: true because a child's path extends its parent's with a selector
-- saying which child it is, and because a node mints at most one name per kind.
-- That half needs an induction over `compileExpr` and is not proved here.
--
-- HOW: by a retraction. `parsePath` reads a rendered path back, and
-- `parse_render` says it recovers exactly what was rendered. A retraction is far
-- less work than direct injectivity -- no reasoning about which of two
-- concatenations is longer -- and it is checked by the same recursion the
-- renderer uses, one case per selector.
--
-- Nothing imports this module, so a normal compile never typechecks it. To check
-- it, name it: `arend arend.yaml Formal.NodePathUnique` (about a second, once the
-- library is loaded).
--
-- Two Arend facts shape the code:
--
--   * a String LITERAL is not a `::`-list, so `("F").bytes = 70 :: nil` is NOT
--     provable by `idp` -- but the evaluator does unfold a literal to match a
--     pattern, so `("F").bytes ++ x = 70 :: x` IS. Every statement below is
--     therefore about a CONCATENATION, never about a literal on its own.
--   * a literal byte pattern must be under 100 (`Value too big` above that), and
--     lowercase letters are not. So the two byte->datatype maps are association
--     tables searched with `==` rather than pattern matches.
-- =============================================================================

-- ---------------------------------------------------------------------------
-- Digits, and the delimiter.
-- ---------------------------------------------------------------------------

-- The digit bytes, and the map back. `byteDigit` is total, with a junk value off
-- the digits; nothing below ever feeds it anything else.
\func byteDigit (b : Byte) : Fin 10 => \case b \with {
  | 48 => 0 | 49 => 1 | 50 => 2 | 51 => 3 | 52 => 4
  | 53 => 5 | 54 => 6 | 55 => 7 | 56 => 8 | 57 => 9
  | _ => 0
}

-- `_` ends a selector's index. The one byte a rendered index cannot contain,
-- which is what makes the selectors a prefix code.
\func isDelim (b : Byte) : Bool => \case b \with {
  | 95 => true
  | _ => false
}

-- ---------------------------------------------------------------------------
-- The numeral: `natToStr` read back.
-- ---------------------------------------------------------------------------

-- Horner's rule: the value of a digit string, most significant first.
\func horner (acc : Nat) (bs : Array Byte) : Nat \elim bs
  | nil => acc
  | b :: bs => horner (acc Nat.* 10 Nat.+ byteDigit b) bs

\lemma horner_++ (acc : Nat) (xs ys : Array Byte) : horner acc (xs ++ ys) = horner (horner acc xs) ys \elim xs
  | nil => idp
  | x :: xs => horner_++ _ xs ys

\lemma horner_digit (acc : Nat) (r : Fin 10) : horner acc (digitLit r).bytes = acc Nat.* 10 Nat.+ r \elim r
  | 0 => idp | 1 => idp | 2 => idp | 3 => idp | 4 => idp
  | 5 => idp | 6 => idp | 7 => idp | 8 => idp | 9 => idp

\lemma le0 {n : Nat} (p : n <= 0) : n = 0 => <=-antisymmetric p zero<=_

-- `q < n` whenever `n` is `10 * q + r` and positive: the decrease that makes the
-- fuelled recursion of `natToStrFuel` re-traceable by induction. Stated on the
-- quotient and remainder so that the quotient is a variable to eliminate.
\lemma div-decr {q r n : Nat} (e : 10 Nat.* q Nat.+ r = n) (p : 0 < n) : q < n \elim q
  | 0 => p
  | suc q => linarith

\lemma div10<= {n fuel : Nat} (p : n <= suc fuel) : n Nat.div 10 <= fuel \elim n
  | 0 => zero<=_
  | suc n =>
    \let | pos : 0 < suc n => linarith
         | d : suc n Nat.div 10 < suc n => div-decr (Nat.divModProp (suc n) 10) pos
    \in <_suc_<= (d <∘l p)

-- The round trip, following `natToStrFuel`/`natToStrStep` step for step.
\lemma horner_natToStrFuel (fuel n : Nat) (p : n <= fuel) : horner 0 (natToStrFuel fuel n).bytes = n \elim fuel
  | 0 => inv (le0 p)
  | suc fuel => horner_natToStrStep fuel (n Nat.div 10) (n Nat.mod 10) (div10<= p) *> Nat.divModProp n 10

\lemma horner_natToStrStep (fuel q : Nat) (r : Fin 10) (p : q <= fuel)
  : horner 0 (natToStrStep fuel q r).bytes = 10 Nat.* q Nat.+ r \elim q
  | 0 => horner_digit 0 r
  | suc q =>
    horner_++ 0 (natToStrFuel fuel (suc q)).bytes (digitLit r).bytes *>
    rewrite (horner_natToStrFuel fuel (suc q) p) (horner_digit (suc q) r *> linarith)

\lemma horner_natToStr (n : Nat) : horner 0 (natToStr n).bytes = n \elim n
  | 0 => idp
  | suc n => horner_natToStrFuel (suc n) (suc n) <=-refl

-- ---------------------------------------------------------------------------
-- The scanner: an index, up to the delimiter.
-- ---------------------------------------------------------------------------

-- `scanStep` exists so that `isDelim b` is a PARAMETER: a `\case` inside a
-- definition does not reduce under a hypothesis about its scrutinee, but a
-- parameter can be rewritten.
\func scanNum (acc : Nat) (bs : Array Byte) : Maybe (\Sigma Nat (Array Byte)) \elim bs
  | nil => nothing
  | b :: bs => scanStep acc b bs (isDelim b)

\func scanStep (acc : Nat) (b : Byte) (bs : Array Byte) (delim : Bool) : Maybe (\Sigma Nat (Array Byte)) \elim delim
  | true => just (acc, bs)
  | false => scanNum (acc Nat.* 10 Nat.+ byteDigit b) bs

-- "contains no delimiter", recursively, so induction over it is induction over
-- the byte list.
\func NoDelim (bs : Array Byte) : \Prop \elim bs
  | nil => \Sigma
  | b :: bs => \Sigma (isDelim b = false) (NoDelim bs)

\lemma noDelim_++ {xs ys : Array Byte} (a : NoDelim xs) (b : NoDelim ys) : NoDelim (xs ++ ys) \elim xs
  | nil => b
  | x :: xs => (a.1, noDelim_++ a.2 b)

\lemma noDelim_digit (r : Fin 10) : NoDelim (digitLit r).bytes \elim r
  | 0 => (idp, ()) | 1 => (idp, ()) | 2 => (idp, ()) | 3 => (idp, ()) | 4 => (idp, ())
  | 5 => (idp, ()) | 6 => (idp, ()) | 7 => (idp, ()) | 8 => (idp, ()) | 9 => (idp, ())

\lemma noDelim_natToStrFuel (fuel n : Nat) : NoDelim (natToStrFuel fuel n).bytes \elim fuel
  | 0 => noDelim_digit 0
  | suc fuel => noDelim_natToStrStep fuel (n Nat.div 10) (n Nat.mod 10)

\lemma noDelim_natToStrStep (fuel q : Nat) (r : Fin 10) : NoDelim (natToStrStep fuel q r).bytes \elim q
  | 0 => noDelim_digit r
  | suc q => noDelim_++ (noDelim_natToStrFuel fuel (suc q)) (noDelim_digit r)

\lemma noDelim_natToStr (n : Nat) : NoDelim (natToStr n).bytes \elim n
  | 0 => noDelim_digit 0
  | suc n => noDelim_natToStrFuel (suc n) (suc n)

\lemma scan_digits (acc : Nat) (ds : Array Byte) (nd : NoDelim ds) (rest : Array Byte)
  : scanNum acc (ds ++ 95 :: rest) = just (horner acc ds, rest) \elim ds
  | nil => idp
  | d :: ds => rewrite nd.1 (scan_digits _ ds nd.2 rest)

-- A rendered index, read back exactly: the number, and the bytes after it. The
-- shape is the one `renderSel` produces -- delimiter literal included, since
-- `("_").bytes` is convertible to `95 :: _` only with something appended.
\lemma scan_index (i : Nat) (rest : Array Byte)
  : scanNum 0 (((natToStr i).bytes ++ ("_" : String).bytes) ++ rest) = just (i, rest)
  => rewrite ++-assoc (scan_digits 0 _ (noDelim_natToStr i) rest *>
                       pmap (\lam v => just (v, rest)) (horner_natToStr i))

-- ---------------------------------------------------------------------------
-- The parser.
-- ---------------------------------------------------------------------------

\data Tok
  | tNone
  | tPlain Sel
  | tIndexed (Nat -> Sel)

-- An association table rather than a pattern match, because a lowercase letter
-- is too big to be a literal pattern. The bytes are the letters `renderSel`
-- emits: this is the one place that correspondence is written down twice, and a
-- wrong byte here does not go unnoticed -- the matching clause of `parse_render`
-- then holds only if `tokOf` agrees with `renderSel`, and fails to typecheck.
\func selTable : Array (\Sigma Byte Tok) =>
  (70, tPlain sFun) ::        -- 'F'
  (65, tPlain sArg) ::        -- 'A'
  (76, tPlain sLamBody) ::    -- 'L'
  (86, tPlain sLetVal) ::     -- 'V'
  (66, tPlain sLetBody) ::    -- 'B'
  (83, tPlain sScrut) ::      -- 'S'
  (80, tPlain sProj) ::       -- 'P'
  (69, tPlain sEta) ::        -- 'E'
  (99, tIndexed sCtorArg) ::  -- 'c'
  (98, tIndexed sBranch) ::   -- 'b'
  (121, tIndexed sMethod) ::  -- 'y'
  (119, tIndexed sWrap) ::    -- 'w'
  nil

-- `StringUtil.lookupKey` is the walk (it is generic in the key's `DecSet`, and
-- `Byte` has one); this only supplies the miss case, since a parser needs a
-- total function here.
\func lookupByte {A : \Type} (b : Byte) (miss : A) (tbl : Array (\Sigma Byte A)) : A =>
  maybe miss (\lam x => x) (lookupKey b tbl)

\func tokOf (b : Byte) : Tok => lookupByte b tNone selTable

\func consJust (s : Sel) (m : Maybe Path) : Maybe Path \elim m
  | nothing => nothing
  | just p => just (s :: p)

-- `fuel` bounds the number of SELECTORS, not the bytes: after an index is
-- scanned the parse continues at a list the checker cannot see as a sub-list of
-- its input, so there is nothing else to count down on.
\func parsePath (fuel : Nat) (bs : Array Byte) : Maybe Path \elim fuel, bs
  | _, nil => just nil
  | 0, _ => nothing
  | suc fuel, b :: bs => parseTok fuel (tokOf b) bs

\func parseTok (fuel : Nat) (t : Tok) (bs : Array Byte) : Maybe Path \elim t
  | tNone => nothing
  | tPlain s => consJust s (parsePath fuel bs)
  | tIndexed f => parseIdx fuel f (scanNum 0 bs)

\func parseIdx (fuel : Nat) (f : Nat -> Sel) (m : Maybe (\Sigma Nat (Array Byte))) : Maybe Path \elim m
  | nothing => nothing
  | just v => consJust (f v.1) (parsePath fuel v.2)

-- ---------------------------------------------------------------------------
-- The retraction, one case per selector.
-- ---------------------------------------------------------------------------

\lemma parse_render (fuel : Nat) (p : Path) (q : p.len <= fuel)
  : parsePath fuel (renderPath p).bytes = just p \elim fuel, p
  -- both, rather than `| fuel, nil`: with `fuel` still a variable the two
  -- overlapping clauses of `parsePath` do not pick one, so it will not reduce.
  | 0, nil => idp
  | suc fuel, nil => idp
  | 0, s :: p => \case le0 q \with {}
  | suc fuel, sFun :: p => pmap (consJust sFun) (parse_render fuel p (suc<=suc.conv q))
  | suc fuel, sArg :: p => pmap (consJust sArg) (parse_render fuel p (suc<=suc.conv q))
  | suc fuel, sLamBody :: p => pmap (consJust sLamBody) (parse_render fuel p (suc<=suc.conv q))
  | suc fuel, sLetVal :: p => pmap (consJust sLetVal) (parse_render fuel p (suc<=suc.conv q))
  | suc fuel, sLetBody :: p => pmap (consJust sLetBody) (parse_render fuel p (suc<=suc.conv q))
  | suc fuel, sScrut :: p => pmap (consJust sScrut) (parse_render fuel p (suc<=suc.conv q))
  | suc fuel, sProj :: p => pmap (consJust sProj) (parse_render fuel p (suc<=suc.conv q))
  | suc fuel, sEta :: p => pmap (consJust sEta) (parse_render fuel p (suc<=suc.conv q))
  | suc fuel, sCtorArg i :: p =>
    pmap (parseIdx fuel sCtorArg) (scan_index i (renderPath p).bytes) *>
    pmap (consJust (sCtorArg i)) (parse_render fuel p (suc<=suc.conv q))
  | suc fuel, sBranch i :: p =>
    pmap (parseIdx fuel sBranch) (scan_index i (renderPath p).bytes) *>
    pmap (consJust (sBranch i)) (parse_render fuel p (suc<=suc.conv q))
  | suc fuel, sMethod i :: p =>
    pmap (parseIdx fuel sMethod) (scan_index i (renderPath p).bytes) *>
    pmap (consJust (sMethod i)) (parse_render fuel p (suc<=suc.conv q))
  | suc fuel, sWrap i :: p =>
    pmap (parseIdx fuel sWrap) (scan_index i (renderPath p).bytes) *>
    pmap (consJust (sWrap i)) (parse_render fuel p (suc<=suc.conv q))

-- ---------------------------------------------------------------------------
-- The theorems.
-- ---------------------------------------------------------------------------

\lemma renderPath-inj {p q : Path} (e : renderPath p = renderPath q) : p = q
  => \let f => p.len Nat.+ q.len
     \in just-injective (
       inv (parse_render f p linarith) *>
       pmap (\lam (s : String) => parsePath f s.bytes) e *>
       parse_render f q linarith)

-- The name kinds, the same way: one byte each, and the map back.
\func kindByte (k : NameKind) : Byte
  | nParam => 112   -- 'p'
  | nLet => 108     -- 'l'
  | nScrut => 100   -- 'd'
  | nThunk => 116   -- 't'
  | nFixInst => 122 -- 'z'
  | nFixClass => 67 -- 'C'

\func kindTable : Array (\Sigma Byte NameKind) =>
  (112, nParam) :: (108, nLet) :: (100, nScrut) ::
  (116, nThunk) :: (122, nFixInst) :: (67, nFixClass) :: nil

\func byteKind (b : Byte) : NameKind => lookupByte b nParam kindTable

\lemma byteKind_kindByte (k : NameKind) : byteKind (kindByte k) = k \elim k
  | nParam => idp | nLet => idp | nScrut => idp
  | nThunk => idp | nFixInst => idp | nFixClass => idp

-- The kind letter, in front of the rendered path. An equation about a
-- CONCATENATION, so the literal in `renderKind` unfolds.
\lemma renderName-bytes (k : NameKind) (p : Path)
  : (renderName k p).bytes = kindByte k :: (renderPath p).bytes \elim k
  | nParam => idp | nLet => idp | nScrut => idp
  | nThunk => idp | nFixInst => idp | nFixClass => idp

\lemma renderName-inj {k1 k2 : NameKind} {p1 p2 : Path} (e : renderName k1 p1 = renderName k2 p2)
  : \Sigma (k1 = k2) (p1 = p2)
  => \let eb : kindByte k1 :: (renderPath p1).bytes = kindByte k2 :: (renderPath p2).bytes =>
       inv (renderName-bytes k1 p1) *> pmap (\lam (s : String) => s.bytes) e *> renderName-bytes k2 p2
     \in (inv (byteKind_kindByte k1) *> pmap byteKind (unhead eb) *> byteKind_kindByte k2,
          renderPath-inj (stringExt (untail eb)))

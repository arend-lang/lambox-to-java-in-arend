\import LambdaBox
\import Data.Bool
\import Data.Maybe
\import Data.String
\import Set
\import StringUtil

-- =============================================================================
-- v2: lambda-box (LBTerm) -> Java source generator, using String (String.ard) as
-- the text type (nowadays just `String`, see String.ard).
--
-- Termination approach: Arend's foetus/size-change checker rejects a separate
-- list-typed helper that calls compileExpr (it crosses the LBTerm <-> Array
-- LBTerm type boundary). So, following arend-lib's HRS.ard
-- (`\lam i => apply (arguments i)`), compileExpr recurses over Array children
-- INLINE via `xs i` / direct projections like `(brs i).2` (same type, indexed
-- sub-term / direct projection of the recursion argument) -- never through a
-- `\case`-bound variable, which loses the structural link the checker needs.
-- The per-child String results are then combined by folds (concatStmts/
-- joinExprs/concatStr) that do NOT call compileExpr, so they terminate on their
-- own.
--
-- No fresh-name counter: a structural `path : String` is passed DOWN and
-- branched per child, so names are unique without left-to-right state
-- threading (which would force a sequential helper).
--
-- Design (unchanged): untyped -> Java `Object`; closures = anonymous inner
-- classes (no invokedynamic); constructors -> `Data{int tag; Object[] fields}`;
-- constants -> zero-arg static methods; fix -> mutable `Fn[]` knot-tying.
--
-- The fixed part of that encoding (`Fn`, `Data` + its `toString`, `BOX`) is NOT
-- generated: it lives in the hand-written `runtime/Rt.java` shipped alongside
-- the output, and generated code refers to it through `rt` below.
-- =============================================================================

-- Name of the runtime class (see runtime/Rt.java); `rt` is the qualifier used
-- in every emitted reference, so renaming the class is a one-line change.
\func runtimeClass : String => "Rt"

\func rt : String => runtimeClass ++ "."

-- Representation of λ□ primitive ints in the generated Java.
--
-- KNOWN MISMATCH (documented, not fixed). A λ□ `prim (primInt, _)` is a 63-bit
-- machine integer with cyclic (mod 2^63) arithmetic -- MetaRocq's
-- erasure/theories/EPrimitive.v has `primIntModel (i : PrimInt63.int)`,
-- lean-to-lambdabox has `PrimModel .primInt := BitVec 63`, and the Rocq refman
-- ("Primitive objects / Primitive integers") specifies the width plus the
-- unsigned/signed views `Uint63`/`Sint63`. No Java type matches that, and our
-- own AST does not either (LambdaBox.ard's `PrimModel primInt => Int` is
-- unbounded). So both choices below are approximations, and the caller picks:
--   * `intBigInteger` -- java.math.BigInteger: unbounded, never overflows, but
--     boxed arithmetic and NO wraparound. Matches OUR AST's `Int`, not the
--     source's int63 nor the C/OCaml int63 runtimes.
--   * `intLong`       -- java.lang.Long: Java's built-in 64-bit integer, much
--     faster, wraps -- but at 2^64, not 2^63 as the source semantics demand,
--     and signed, whereas `PrimInt63` reduction is unsigned/cyclic.
-- Both agree with the C backend (CertiRocq's prim_int63_*) and the OCaml one
-- (unboxed OCaml `int`, cf. ExtrOCamlInt63) only while values stay well below
-- 2^62, which holds for the current examples.
-- FUTURE WORK: a third `intInt63` representation whose literals and
-- `Rt.PRIM_*` ops normalize mod 2^63 (following `Uint63`), which is the only
-- one that could be proved to agree with λ□'s evaluation relation once that
-- exists. See LambdaBox.ard's `PrimModel` and RESEARCH_AND_PLAN.md.
--
-- Everything below is parameterized by this choice; there is no default hidden
-- inside the generator (see `compileProgramWith` / `compileProgram`).
\data JavaIntRepr
  | intBigInteger
  | intLong

-- A `prim (primInt, i)` literal in the chosen representation.
\func primIntLit (ir : JavaIntRepr) (i : Int) : String \elim ir
  | intBigInteger => "new java.math.BigInteger(\"" ++ intToStr i ++ "\")"
  | intLong => "Long.valueOf(" ++ intToStr i ++ "L)"

-- Suffix of the runtime's primitive-op constants (`Rt.PRIM_ADD_INT` vs
-- `Rt.PRIM_ADD_LONG`); the two families are otherwise identical in ABI.
\func primOpSuffix (ir : JavaIntRepr) : String \elim ir
  | intBigInteger => "INT"
  | intLong => "LONG"

-- Realization of λ□ axioms (constants without a body) in the Java runtime.
-- Peregrine does this per run via `--attributes` (see ExampleMatMul.ard's
-- matMulAttrsC/OCaml, remapping onto CertiRocq's prim_int63_*); the Java
-- backend instead has this fixed table of axiom name -> runtime expression,
-- since the runtime it targets (`runtime/Rt.java`) is ours. An axiom listed
-- here compiles to the runtime constant, everything else to a throwing stub.
\func javaAxioms (ir : JavaIntRepr) : Array (\Sigma String String) =>
  \let | op (nm : String) => rt ++ "PRIM_" ++ nm ++ "_" ++ primOpSuffix ir
  \in ("prim_add_int", op "ADD") ::
      ("prim_mul_int", op "MUL") ::
      ("prim_sub_int", op "SUB") ::
      ("prim_eqb_int", op "EQB") ::
      nil

-- Lookup by unqualified kername; the primitives live in the root module path.
\func lookupAxiom (name : String) (tbl : Array (\Sigma String String)) : Maybe String \elim tbl
  | nil => nothing
  | e :: tbl => \case e.1 == name \with {
    | true => just e.2
    | false => lookupAxiom name tbl
  }

-- Compilation result: (statements, value-expression), both plain String.
\func Out : \Type => \Sigma String String

-- de Bruijn lookup: env head = index 0. A bound name is a literal prefix
-- concatenated with the node's `path`.
-- An index larger than the number of enclosing binders is ill-formed input (a
-- closed λ□ program has none), so instead of a silent `null` we emit a runtime
-- call that fails immediately and reports the index and the node.  `n0` is the
-- original index, kept for the message while `n` counts down.
\func nthName (n : Nat) (env : Array String) (n0 : Nat) (path : String) : String \elim n, env
  | _, nil => rt ++ "unbound(" ++ natToStr n0 ++ ", \"" ++ path ++ "\")"
  | 0, x :: _ => x
  | suc n, _ :: env => nthName n env n0 path

-- Folds over per-child results. None call compileExpr -> separate SCC.
\func concatStmts (rs : Array Out) : String \elim rs
  | nil => ""
  | r :: rs => r.1 ++ concatStmts rs

\func joinExprs (rs : Array Out) : String \elim rs
  | nil => ""
  | r :: nil => r.2
  | r :: rs => r.2 ++ ", " ++ joinExprs rs

-- Kername -> Java method name. Identifiers arriving from the source are assumed
-- to be valid Java identifiers already; real sanitization (replacing illegal
-- characters) would need byte/char-level rewriting and belongs at the
-- host/extension boundary.
\func joinDirs (ds : Array String) : String \elim ds
  | nil => ""
  | d :: nil => d
  | d :: ds => d ++ "_" ++ joinDirs ds

\func mangleModPath (mp : ModPath) : String \elim mp
  | mpFile dp => joinDirs dp
  | mpBound dp id n => joinDirs dp ++ "_" ++ id ++ "_" ++ natToStr n
  | mpDot mp id => mangleModPath mp ++ "_" ++ id

\func mangleKername (k : Kername) : String =>
  "c_" ++ mangleModPath k.kerModPath ++ "__" ++ k.kerName

-- Bind a branch's fields to fresh locals, starting at field index `fieldIx`
-- (= npars, to skip inductive parameters). Returns (bind-statements, extended env).
-- Recurses on the binder array only; never calls compileExpr.
-- Pushing left-to-right makes the LAST binder de Bruijn index 0 (matches iota_red).
\func bindFields (dv : String) (fieldIx : Nat) (bs : Array BinderName) (env : Array String) (path : String)
  : \Sigma String (Array String) \elim bs
  | nil => ("", env)
  | _ :: bs =>
    \let | nm => "g" ++ natToStr fieldIx ++ path
         | st => "final Object " ++ nm ++ " = " ++ dv ++ ".fields[" ++ natToStr fieldIx ++ "]; "
         | r  => bindFields dv (suc fieldIx) bs (nm :: env) path
    \in (st ++ r.1, r.2)

-- Push the k fix-slot names arr[0..k-1] onto env; head = arr[k-1] = de Bruijn 0
-- (= the LAST mutually-defined function, matching λ□'s fix_subst). No compileExpr.
\func pushFix (arr : String) (j k : Nat) (env : Array String) : Array String \elim k
  | 0 => env
  | suc k => pushFix arr (suc j) k ((arr ++ "[" ++ natToStr j ++ "]") :: env)

-- Core compiler. `path` uniquely identifies this node; binder names and child
-- paths are derived from it, so no state threading is needed.
\func compileExpr (ir : JavaIntRepr) (env : Array String) (path : String) (t : LBTerm) : Out \elim t
  | box => ("", rt ++ "BOX")

  | bvar n => ("", nthName n env n path)

  -- A locally-nameless free variable has no Java counterpart at all (the
  -- serializer likewise emits `tVar_UNREACHABLE`), so compile it to a throwing
  -- runtime call naming the variable rather than to a silent `null`.
  | fvar v => ("", rt ++ "freeVar(\"" ++ v.varName ++ "\", \"" ++ path ++ "\")")

  | prim (primInt, i) => ("", primIntLit ir i)

  | const k => ("", mangleKername k ++ "()")

  | app f a =>
    \let | of => compileExpr ir env ("F" ++ path) f
         | oa => compileExpr ir env ("A" ++ path) a
    \in (of.1 ++ oa.1, "((" ++ rt ++ "Fn)(" ++ of.2 ++ ")).apply(" ++ oa.2 ++ ")")

  | lambda _ body =>
    \let | pv => "p" ++ path
         | ob => compileExpr ir (pv :: env) ("L" ++ path) body
    \in ("", "new " ++ rt ++ "Fn(){ public Object apply(Object " ++ pv ++ "){ " ++ ob.1 ++ " return " ++ ob.2 ++ "; } }")

  | letIn _ value body =>
    \let | ov => compileExpr ir env ("V" ++ path) value
         | lv => "l" ++ path
         | ob => compileExpr ir (lv :: env) ("B" ++ path) body
    \in (ov.1 ++ "final Object " ++ lv ++ " = " ++ ov.2 ++ "; " ++ ob.1, ob.2)

  -- construct: recurse inline over the Array of args.
  | construct _ cidx args =>
    \let | results => \new Array Out args.len (\lam i => compileExpr ir env ("c" ++ natToStr i ++ path) (args i))
    \in (concatStmts results,
         "new " ++ rt ++ "Data(" ++ natToStr cidx ++ ", new Object[]{ " ++ joinExprs results ++ " })")

  -- case: switch on the scrutinee's tag; each branch binds fields[npars ..] then
  -- evaluates its body. We map inline over `brs i`, binding the body by pattern.
  | case _ npars scrut brs =>
    \let | os => compileExpr ir env ("S" ++ path) scrut
         | dv => "d" ++ path
         | rv => "r" ++ path
         -- Recurse on the DIRECT projection `(brs i).2`, NOT a `\case`-bound
         -- variable: the checker tracks `(brs i).2 < t` (index into the sub-term
         -- `brs`, then project) but loses that through a `\case` pattern binding.
         | cases => \new Array String brs.len (\lam i =>
             \let | bp  => "b" ++ natToStr i ++ path
                  | bnd => bindFields dv npars (brs i).1 env bp
                  | ob  => compileExpr ir bnd.2 bp (brs i).2
             \in "case " ++ natToStr i ++ ": { " ++ bnd.1 ++ ob.1
                  ++ rv ++ " = " ++ ob.2 ++ "; break; } ")
    \in (os.1
           ++ "final " ++ rt ++ "Data " ++ dv ++ " = (" ++ rt ++ "Data)(" ++ os.2 ++ "); "
           ++ "Object " ++ rv ++ "; "
           ++ "switch (" ++ dv ++ ".tag) { " ++ concatStr cases
           ++ "default: throw new RuntimeException(\"no matching branch\"); } ",
         rv)

  | proj pinfo scrut =>
    \let | os => compileExpr ir env ("P" ++ path) scrut
    \in (os.1,
         "((" ++ rt ++ "Data)(" ++ os.2 ++ ")).fields["
           ++ natToStr (pinfo.projParamCount) ++ " + " ++ natToStr (pinfo.projFieldIdx) ++ "]")

  -- fix: mutable Fn[] + knot-tying; map inline over `defs j`, projecting the
  -- body directly (`(defs j).defBody`), same reasoning as `case` above.
  | fix defs idx =>
    \let | arr => "x" ++ path
         | k   => defs.len
         | env' => pushFix arr 0 k env
         | assigns => \new Array String k (\lam j =>
             \let | ob => compileExpr ir env' ("y" ++ natToStr j ++ path) (defs j).defBody
             \in ob.1 ++ arr ++ "[" ++ natToStr j ++ "] = (" ++ rt ++ "Fn)(" ++ ob.2 ++ "); "
         )
    \in ("final " ++ rt ++ "Fn[] " ++ arr ++ " = new " ++ rt ++ "Fn[" ++ natToStr k ++ "]; " ++ concatStr assigns,
         arr ++ "[" ++ natToStr idx ++ "]")


-- ---------------------------------------------------------------------------
-- Program assembly.
-- ---------------------------------------------------------------------------

\func compileDecl (ir : JavaIntRepr) (kd : \Sigma Kername GlobalDecl) : String =>
  \let | name => mangleKername kd.1
  \in \case kd.2 \with {
    | constantDecl cb => \case cb.cstBody \with {
      | just body =>
        \let | o => compileExpr ir nil "" body
        \in "  public static Object " ++ name ++ "(){ " ++ o.1 ++ " return " ++ o.2 ++ "; }\n"
      | nothing => \case lookupAxiom kd.1.kerName (javaAxioms ir) \with {
        | just impl => "  public static Object " ++ name ++ "(){ return " ++ impl ++ "; }\n"
        | nothing =>
          "  public static Object " ++ name ++ "(){ throw new RuntimeException(\"axiom " ++ name ++ " not implemented\"); }\n"
      }
    }
    | inductiveDecl _ => "  /* inductive " ++ name ++ ": erased; values use Data(tag, fields) */\n"
  }

\func compileDecls (ir : JavaIntRepr) (ds : GlobalDeclarations) : String \elim ds
  | nil => ""
  | d :: ds => compileDecl ir d ++ compileDecls ir ds

\func compileMain (ir : JavaIntRepr) (t : LBTerm) : String =>
  \let | o => compileExpr ir nil "" t
  \in "  public static Object __main(){ " ++ o.1 ++ " return " ++ o.2 ++ "; }\n" ++
     "  public static void main(String[] args){ System.out.println(__main()); }\n"

-- Only the program-specific class is generated; `Fn`, `Data` (with its
-- human-readable `toString`) and `BOX` come from the hand-written runtime class
-- `runtime/Rt.java`, which must be compiled together with this output.
-- The int representation is explicit here; `compileProgram` below keeps
-- BigInteger as the conservative default (no silent overflow).
\func compileProgramWith (ir : JavaIntRepr) (p : LBProgram) : String =>
  "public final class Prog {\n" ++
  compileDecls ir p.1 ++ compileMain ir p.2 ++ "}\n"

\func compileProgram (p : LBProgram) : String => compileProgramWith intBigInteger p


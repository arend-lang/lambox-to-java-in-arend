\import LambdaBox
-- Only `map`/`mkArray`/`Big`: importing Data.Array wholesale would shadow
-- String's `++` with the Array one, so array append is imported under the
-- alias `++A` (used in `appendStmts` and `compileClass` below).
\import Data.Array (map, mkArray, Big, ++ \as \infixr 5 ++A)
\import Data.Maybe
\import Data.String
\import JavaAst
\import JavaAxioms
\import JavaPrint
\import NodePath
\import StringUtil

-- =============================================================================
-- lambda-box (LBTerm) -> Java generator.
--
-- Builds `JavaAst` values, not source text; `compileProgram` composes generator
-- and printer, so callers still get a `String`.
--
-- Design: untyped -> `Object`; closures -> anonymous inner classes (no
-- invokedynamic); constructors -> `Data{int tag; Object[] fields}`; `case` -> a
-- chain of `?:` on the tag; constants -> zero-argument static methods; `fix` -> a
-- local class with one method per mutually defined function. The program's term
-- becomes `body()`, and no entry point is generated (`compileBody`).
--
-- EVERY λ□ NODE DENOTES AN EXPRESSION. `Out` carries a statement prelude too, but
-- only to NAME values (a `letIn`, a `case` scrutinee, a `fix` instance): no
-- statement branches, so nothing depends on a statement having run.
--
-- No configuration: `compileProgram` takes a class name and a program. Every
-- option would be a case a semantics must interpret and a proof must discharge.
-- No runtime member is named in this file either -- the core is reached through
-- the AST's ABI nodes, the periphery through `JavaAxioms.ard`.
--
-- TERMINATION. Arend's foetus checker rejects a separate list-typed helper that
-- calls `compileExpr`, since that crosses the LBTerm <-> Array LBTerm boundary.
-- So, following arend-lib's HRS.ard, `compileExpr` recurses over `Array` children
-- INLINE -- `xs i`, or a direct projection like `(brs i).2` -- and never through a
-- `\case`-bound variable, which loses the structural link. `Data.Array.map` is
-- unusable inside the cycle for the same reason: it hides the index behind a
-- closure (verified). Hence `mkArray {..} {xs.len} (\lam i => .. (xs i))`;
-- combining results with `++`/`Big`/`map` is fine, as those never call back in.
--
-- Names derive from a structural `path : Path` passed down and branched per child,
-- so there is no fresh-name counter and no state to thread. A path is a list of
-- child selectors and a name is a (kind, path) pair; both are datatypes, and
-- `NodePath.ard` is the one place either becomes text.
-- =============================================================================

-- Compilation result: (statements to run first, value expression).
\func Out : \Type => \Sigma (Array JStmt) JExpr

-- The environment maps a de Bruijn index to the EXPRESSION that denotes it:
-- usually a variable (`jVar "p3"`), but a `fix` sibling is a whole forwarding
-- closure (see `fixMethodRef`), which is why this is an `Array JExpr` and not an
-- `Array JIdent`. Head = index 0.
-- An index larger than the number of enclosing binders is ill-formed input; see
-- `rtUnbound` (JavaAxioms.ard) for what it compiles to and why. `n0` is the
-- original index, kept for that message while `n` counts down.
\func nthVar (n : Nat) (env : Array JExpr) (n0 : Nat) (path : Path) : JExpr \elim n, env
  | _, nil => rtUnbound n0 path
  | 0, x :: _ => x
  | suc n, _ :: env => nthVar n env n0 path

-- Array append and flattening of per-child results. Both come from Data.Array;
-- neither calls compileExpr, so the recursion above stays in its own SCC.
-- `appendStmts` is the main place the aliased array append `++A` is used (see
-- the import).
\func appendStmts (xs ys : Array JStmt) : Array JStmt => xs ++A ys

\func concatStmtBlocks (bs : Array (Array JStmt)) : Array JStmt => Big appendStmts nil bs

-- The statements of a sequence of child results, in order.
\func concatStmts (rs : Array Out) : Array JStmt => concatStmtBlocks (map (\lam r => r.1) rs)

-- Kername -> Java method name. Every source component is encoded at this one
-- boundary; the fixed separators and leading `c_` are legal by construction.
\func joinDirs (ds : Array String) : String \elim ds
  | nil => ""
  | d :: nil => javaIdentPart d
  | d :: ds => javaIdentPart d ++ "_" ++ joinDirs ds

\func mangleModPath (mp : ModPath) : String \elim mp
  | mpFile dp => joinDirs dp
  | mpBound dp id n => joinDirs dp ++ "_" ++ javaIdentPart id ++ "_" ++ natToStr n
  | mpDot mp id => mangleModPath mp ++ "_" ++ javaIdentPart id

\func mangleKername (k : Kername) : String =>
  "c_" ++ mangleModPath k.kerModPath ++ "__" ++ javaIdentPart k.kerName

-- Push a branch's field binders onto the environment, starting at field index
-- `fieldIx` (= npars, to skip inductive parameters).
--
-- A binder is bound to the EXPRESSION `d.fields[i]`, not to a local holding it.
-- That is what makes a branch body statement-free, which is what lets `case` be
-- an expression (see the `case` clause) -- a `final Object g0 = d.fields[0];`
-- would force every branch with a binder through a thunk. Sound because the read
-- is pure, and cheap because it is constant-size, so unlike substituting a value
-- expression it cannot blow up however often the binder is used.
--
-- Recurses on the binder array only; never calls compileExpr. Pushing
-- left-to-right makes the LAST binder de Bruijn index 0 (matches iota_red).
\func pushFields (dv : JExpr) (fieldIx : Nat) (bs : Array BinderName) (env : Array JExpr)
  : Array JExpr \elim bs
  | nil => env
  | _ :: bs => pushFields dv (suc fieldIx) bs (jDataField dv fieldIx :: env)

-- ---------------------------------------------------------------------------
-- The ternary-chain `case` encoding; see the `case` clause of `compileExpr`.
-- ---------------------------------------------------------------------------

-- One branch as an ARM of the chain. A branch body that needs statements -- a
-- nested `letIn`, `case` or `fix` -- cannot be spliced in directly, because an
-- arm must not run unless it is selected, and statements would have to be hoisted
-- out of the conditional to run unconditionally. Such a branch becomes a THUNK
-- applied at once: `((Rt.Fn)(new Rt.Fn(){ .. })).apply(Rt.BOX)`.
--
-- Only the SELECTED arm's thunk is allocated -- the allocation is inside the arm
-- -- which is what this buys over passing all k branches to a runtime `match`.
\func armExpr (stmts : Array JStmt) (val : JExpr) (path : Path) : JExpr \elim stmts
  | nil => val
  | s :: ss =>
    jApply (jClosure (renderName nThunk path) (appendStmts (s :: ss) (jReturn val :: nil))) jBox

-- The arms, as one nested conditional: `d.tag == 0 ? a0 : d.tag == 1 ? a1 : ..`.
-- `tag` counts up with the position, since a branch's index IS its constructor's
-- tag.
--
-- The chain ends in `Rt.noBranch`, not in the last arm. Using the last arm would
-- drop k-1 comparisons for a total match -- which every match coming out of
-- erasure is -- but it would also turn a scrutinee with an impossible tag from an
-- immediate error into a silently wrong answer. It is the `default:` the earlier
-- `switch` encoding threw from.
\func condChain (scrut : JExpr) (tag : Nat) (arms : Array JExpr) (path : Path) : JExpr \elim arms
  | nil => rtNoBranch scrut path
  | a :: arms => jCond (jTagEq scrut tag) a (condChain scrut (suc tag) arms path)

-- ---------------------------------------------------------------------------
-- The local-class `fix` encoding; see the `fix` clause of `compileExpr`.
-- ---------------------------------------------------------------------------

-- The j-th method of a fix's local class. The only generated name that is NOT
-- path-derived, and the only one that needs no path: a method name lives in its
-- own class's namespace, and the class is fresh, so `j` alone separates them.
\func fixMethodName (j : Nat) : String => "f" ++ natToStr j

-- The j-th sibling AS A VALUE: a closure forwarding to the method, since λ□ lets
-- a sibling be passed around and a method is not an `Rt.Fn`.
--
-- One `new` per occurrence, deliberately: a wrapper cached in a
-- constructor-assigned field would reintroduce the initialization order this
-- encoding avoids, and one bound per method would allocate k on every call. Per
-- use, the common case -- a self-recursive call -- does not escape, which escape
-- analysis should remove entirely.
--
-- `recv`: `FixP.this` from inside the class, the instance local from outside.
--
-- The closure's parameter is an ordinary parameter, at a path of its own
-- (`sWrap j`): this site compiles no child, so that path names nothing else.
\func fixMethodRef (recv : JExpr) (path : Path) (j : Nat) : JExpr =>
  \let wp => renderName nParam (sWrap j :: path)
  \in jClosure wp (jReturn (jInvoke recv (fixMethodName j) (jVar wp :: nil)) :: nil)

-- Push the k siblings onto env as forwarding closures; head = f(k-1) = de
-- Bruijn 0, the same order `pushFix` establishes for the array encoding
-- (λ□'s fix_subst). No compileExpr.
\func pushFixMethods (recv : JExpr) (path : Path) (j k : Nat) (env : Array JExpr)
  : Array JExpr \elim k
  | 0 => env
  | suc k => pushFixMethods recv path (suc j) k (fixMethodRef recv path j :: env)

-- Core compiler. `path` uniquely identifies this node; binder names and child
-- paths are derived from it, so no state threading is needed.
\func compileExpr (env : Array JExpr) (path : Path) (t : LBTerm) : Out \elim t
  | box => (nil, jBox)

  | bvar n => (nil, nthVar n env n path)

  -- A locally-nameless free variable has no Java counterpart at all (the
  -- serializer likewise emits `tVar_UNREACHABLE`); see `rtFreeVar`.
  | fvar v => (nil, rtFreeVar v.varName path)

  | prim (primInt, i) => (nil, intLit i)

  | const k => (nil, jCallStatic (mangleKername k) nil)

  | app f a =>
    \let | of => compileExpr env (sFun :: path) f
         | oa => compileExpr env (sArg :: path) a
    \in (appendStmts of.1 oa.1, jApply of.2 oa.2)

  | lambda _ body =>
    \let | pv => renderName nParam path
         | ob => compileExpr (jVar pv :: env) (sLamBody :: path) body
    \in (nil, jClosure pv (appendStmts ob.1 (jReturn ob.2 :: nil)))

  | letIn _ value body =>
    \let | ov => compileExpr env (sLetVal :: path) value
         | lv => renderName nLet path
         | ob => compileExpr (jVar lv :: env) (sLetBody :: path) body
    \in (appendStmts ov.1 (jLocal tObject lv ov.2 :: ob.1), ob.2)

  -- construct: recurse inline over the Array of args.
  | construct _ cidx args =>
    \let | results => mkArray {Out} {args.len} (\lam i => compileExpr env (sCtorArg i :: path) (args i))
    \in (concatStmts results, jDataNew cidx (map (\lam r => r.2) results))

  -- case: a chain of `d.tag == i ? <branch i>` tests, which is what λ□'s own
  -- `iota` rule says -- the branch selected by the scrutinee's constructor IS the
  -- value. So this node has ONE statement, naming the scrutinee, and its value is
  -- an expression; there is no result variable to assign, and hence no invariant
  -- that every branch assigns it.
  --
  -- The scrutinee is named because the chain mentions it k+1 times (each tag test,
  -- plus every field read reached through `pushFields`) and re-evaluating it would
  -- be exponential in the nesting depth of matches. The `Rt.Data` cast is on that
  -- one local, so nothing downstream casts again.
  --
  -- A match with NO branches (an erased `Empty`) still evaluates and casts the
  -- scrutinee, as the `switch` encoding did, and its value is `Rt.noBranch`.
  | case _ npars scrut brs =>
    \let | os => compileExpr env (sScrut :: path) scrut
         | dv => renderName nScrut path
         | d  => jVar dv
         -- Recurse on the DIRECT projection `(brs i).2`, NOT a `\case`-bound
         -- variable: the checker tracks `(brs i).2 < t` (index into the sub-term
         -- `brs`, then project) but loses that through a `\case` pattern binding.
         | arms => mkArray {JExpr} {brs.len} (\lam i =>
             \let | bp => sBranch i :: path
                  | ob => compileExpr (pushFields d npars (brs i).1 env) bp (brs i).2
             \in armExpr ob.1 ob.2 bp)
    \in (appendStmts os.1 (jLocal tData dv (jCast tData os.2) :: nil),
         condChain d 0 arms path)

  -- proj: the AST has no arithmetic node, so `npars + idx` is added here.
  | proj pinfo scrut =>
    \let | os => compileExpr env (sProj :: path) scrut
    \in (os.1,
         jDataField (jCast tData os.2) (pinfo.projParamCount Nat.+ pinfo.projFieldIdx))

  -- fix: a LOCAL CLASS with one method per mutually defined function. The knot is
  -- tied by the class declaration, so there are no mutable cells and no side
  -- condition about a slot being read before it is assigned. `Fix<path>.this` is
  -- how a method reaches a sibling, the forwarding closure's own `this` being the
  -- closure. Maps inline over `defs j` for the termination reason above, which is
  -- also what keeps the mutual recursion with `compileFixMethod` in reach.
  | fix defs idx =>
    \let | k     => defs.len
         | cls   => renderName nFixClass path
         | inst  => renderName nFixInst path
         | env'  => pushFixMethods (jQualThis cls) path 0 k env
         | methods => mkArray {\Sigma JIdent JIdent (Array JStmt)} {k} (\lam j =>
             \let | m => compileFixMethod env' (sMethod j :: path) (defs j).defBody
             \in (fixMethodName j, m.1, m.2))
    \in (jLocalClass cls methods ::
         jLocal (tClass cls) inst (jNew (tClass cls) nil) ::
         nil,
         fixMethodRef (jVar inst) path idx)

-- One method of a `fix` local class: (parameter name, body).
--
-- Mutually recursive with `compileExpr`, and it `\elim`s the body to STRIP THE
-- GUARDING LAMBDA, so a self-recursive call becomes a call rather than a closure
-- allocation plus an interface dispatch. A separate `\elim` and not an inner
-- `\case`, which would lose the structural link (see TERMINATION).
--
-- The second clause eta-expands an UNGUARDED body (`fix [f => f] 0`): such a λ□
-- term diverges, and so does this Java, loudly. That is why the encoding needs no
-- well-formedness side condition, and why the clause is not dead weight even
-- though erasure output is always a lambda.
\func compileFixMethod (env : Array JExpr) (path : Path) (t : LBTerm)
  : \Sigma JIdent (Array JStmt) \elim t
  | lambda _ inner =>
    \let | pv => renderName nParam path
         | ob => compileExpr (jVar pv :: env) (sLamBody :: path) inner
    \in (pv, appendStmts ob.1 (jReturn ob.2 :: nil))
  | t =>
    \let | pv => renderName nParam path
         -- `sEta`, not `path`: the body is a child of the eta-expansion, so a body
         -- that happened to be a lambda mints its parameter at a path of its own
         -- rather than at this method's -- which is now a property of the path,
         -- not of `\elim` having taken the clause above first.
         | ot => compileExpr env (sEta :: path) t
    \in (pv, jComment "unguarded fix body: eta-expanded (diverges instead of reading an unassigned slot)" ::
             appendStmts ot.1 (jReturn (jApply ot.2 (jVar pv)) :: nil))


-- ---------------------------------------------------------------------------
-- Program assembly.
-- ---------------------------------------------------------------------------

-- Every generated member is a `public static Object f(){ .. }`, and `JMethod`
-- holds nothing else (see JavaAst.ard), so this is the whole of method assembly.
\func constMethod (name : String) (body : Array JStmt) : JMember =>
  jMethod (\new JMethod name body)

\func compileDecl (kd : \Sigma Kername GlobalDecl) : JMember =>
  \let | name => mangleKername kd.1
  \in \case kd.2 \with {
    | constantDecl cb => \case cb.cstBody \with {
      | just body =>
        \let | o => compileExpr nil nil body
        \in constMethod name (appendStmts o.1 (jReturn o.2 :: nil))
      | nothing => \case axiomImpl name \with {
        | just impl => constMethod name (jReturn impl :: nil)
        | nothing =>
          constMethod name
            (jThrow (jNew (tClass "RuntimeException")
                          (jLit (litStr ("axiom " ++ name ++ " not implemented")) :: nil)) :: nil)
      }
    }
    | inductiveDecl _ =>
      jMemberComment ("inductive " ++ name ++ ": erased; values use Data(tag, fields)")
  }

\func compileDecls (ds : GlobalDeclarations) : Array JMember =>
  map (\lam d => compileDecl d) ds

-- `body` is a fixed, unmangled name, and cannot collide with a compiled λ□
-- constant: `mangleKername` prefixes every one of those with `c_`.
\func bodyMethodName : JIdent => "body"

-- The program's term, as the one method a caller starts from:
--
--   public static Object body(){ .. return <the program's value>; }
--
-- NO ENTRY POINT IS GENERATED: a λ□ term is a VALUE, and whether to print it or
-- evaluate it at all is the caller's decision -- while a generated `main` also
-- stopped two extracted classes sharing one Java program. `runtime/Main.java.in`
-- is the hand-written example the harness uses, and records why it goes through
-- `Rt.runMain` (non-tail `fix` recursion needs a stack the OS does not give the
-- primordial thread).
\func compileBody (t : LBTerm) : Array JMember =>
  \let | o => compileExpr nil nil t
  \in constMethod bodyMethodName (appendStmts o.1 (jReturn o.2 :: nil)) :: nil

-- Only the program-specific class is generated; `Fn`, `Data` and `BOX` come from
-- `runtime/Rt.java`, compiled alongside. `name` is an argument so that two
-- independently extracted programs can coexist.
--
-- Coexisting is not COOPERATING: a λ□ `const` compiles to an unqualified
-- `c_foo()`, resolved inside the enclosing class, so two classes cannot call each
-- other's constants nor share one copy of `Nat.add`. That needs a resolver
-- `Kername -> Maybe JQIdent` in `compileExpr` -- the generalization of
-- `JavaAxioms.ard`'s table, an axiom being a kername resolved to an outside name.
\func compileClass (name : JIdent) (p : LBProgram) : JClass =>
  \new JClass name (compileDecls p.1 ++A compileBody p.2)

-- The generator and the printer, composed: the whole backend.
\func compileProgram (name : JIdent) (p : LBProgram) : String =>
  printClass (compileClass name p)

-- Print a generated program with `putStrLn` (Data.String -> console).
-- \import Debug
-- \func main => putStrLn (compileProgram "Prog" (nil, prim (primInt, -44)))
\import Data.String  -- the `"Prog"` class-name literal the `*Java` printers pass
\import Debug
\import Example (testProgram)
\import ExampleLetChain (letChainProgram)
\import ExampleMatMul (matMulAttrsC, matMulAttrsOCaml, matMulProgram, matMulProgramOf)
\import ExamplePeano (addProgram)
\import Serialize
\import ToJava

-- =============================================================================
-- Printing entry points for the example programs.
--
-- Typechecking a definition here prints its result (`putStrLn` runs during
-- typechecking). Kept OUT of the Example*.ard modules on purpose: evaluating a
-- whole generated program needs a much bigger stack (the Arend CLI has to be
-- run with e.g. `-Xss1g`), while the example *definitions* themselves
-- typecheck with the default stack -- so the two can be checked independently.
--
-- Only the example entry points are imported by name, since the modules
-- otherwise share definition names (`decls`, `mainTerm`, ...).
--
-- `*Java` prints the generated Java. There is one int representation, Java's
-- built-in 64-bit integers, and no generator options at all -- the
-- `*JavaBigInteger` variants that used to sit beside these are gone with the
-- `JavaTarget` record (see ONE TARGET, NO OPTIONS in ToJava.ard).
-- =============================================================================

\func exampleJava => putStrLn (compileProgram "Prog" testProgram)
\func exampleSexpr => putStrLn (LambdaBoxToSrting testProgram)

\func peanoJava => putStrLn (compileProgram "Prog" addProgram)
\func peanoSexpr => putStrLn (LambdaBoxToSrting addProgram)

\func matMulJava => putStrLn (compileProgram "Prog" matMulProgram)
\func matMulSexpr => putStrLn (LambdaBoxToSrting matMulProgram)
-- The same program at other sizes, for the runtime benchmark of the corpus
-- (`matmul250`): identical term shape, one literal apart. See
-- ExampleMatMul.sizeLitOf and test/benchmarks.md.
\func matMulSexpr200 => putStrLn (LambdaBoxToSrting (matMulProgramOf 200))
\func matMulSexpr250 => putStrLn (LambdaBoxToSrting (matMulProgramOf 250))
\func matMulSexpr300 => putStrLn (LambdaBoxToSrting (matMulProgramOf 300))
\func matMulAttrsCText => putStrLn (AttributesToString matMulAttrsC)
\func matMulAttrsOCamlText => putStrLn (AttributesToString matMulAttrsOCaml)

-- The `letIn` worst case (corpus program `letchain`). Java only, so no
-- attribute files; see ExampleLetChain.ard.
\func letChainJava => putStrLn (compileProgram "Prog" letChainProgram)
\func letChainSexpr => putStrLn (LambdaBoxToSrting letChainProgram)

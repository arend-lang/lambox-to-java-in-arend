\import LambdaBox
\import Data.Bool
\import Data.Maybe
\import Data.String

-- =============================================================================
-- A WORST CASE FOR THE `letIn` ENCODING: a hot loop that is almost entirely
-- `let`s.
--
--   letChainInner j acc = if j == 0 then acc else
--     let a1 = acc + 1 in let a2 = a1 + 1 in .. let aN = a(N-1) + 1 in
--     letChainInner (j - 1) aN
--   letChainOuter i acc = if i == 0 then acc else
--     letChainOuter (i - 1) (letChainInner INNER acc)
--   res = letChainOuter OUTER 0
--
-- so the value is OUTER * INNER * N, and N lets are evaluated per inner
-- iteration with nothing else between them.
--
-- WHY THIS SHAPE. `ToJava.ard` can compile `letIn` two ways, and the corpus
-- could not tell them apart: a `final Object l = v;` statement costs nothing at
-- runtime, while the expression form `((Rt.Fn)(new Rt.Fn(){ .. })).apply(v)` --
-- λ□'s own equation `let x = v in b == (\lam x => b) v` -- costs a closure
-- allocation plus an interface dispatch. This program is built so that cost is
-- essentially the whole runtime: the lets are the loop body.
--
--   * Every let is USED, by the next one, so none can be eliminated. The chain
--     is a data dependency, not a sequence of dead bindings.
--   * Every let's value is one `add`, the cheapest thing that still cannot be
--     folded away, so the let ENCODING dominates rather than the work inside.
--   * TWO nested loops rather than one long one, because λ□ `fix` compiles to
--     non-tail Java recursion: iterations are stack frames. 2000 x 2000 gives
--     4,000,000 inner iterations at a recursion depth of ~4000 instead of
--     4,000,000 deep, which would need a stack no `-Xss` will give.
--
-- Being a worst case is the POINT, so do not read a regression here as the cost
-- on real code -- read it as the ceiling. `lean-matmul` (15 lets, some hot) is
-- the realistic middle, and `matmul` has no `letIn` at all.
--
-- Its measurement is conservative in one way worth knowing: `Long.valueOf`
-- allocates for values above the box cache, and this program's accumulator runs
-- to 80,000,000, so both encodings pay boxing on every `add`. That raises the
-- shared baseline and therefore UNDERSTATES the ratio between them.
--
-- Follows ExampleMatMul.ard's conventions: `bvar` indices written out by hand,
-- Kernames inline at each occurrence, and the four primitive-op axioms named as
-- there so `JavaAxioms.ard`'s table realizes them (see that file's PRIMITIVE
-- OPS note). Only add/sub/eqb are used; `mul` is not declared, and this program
-- declares only the `java` backend, so it needs no attribute files.
-- =============================================================================

\func app2 (f a b : LBTerm) : LBTerm => app (app f a) b

-- `eqb` returns this 2-constructor inductive: constructor 0 is false, 1 is true,
-- matching the branch order of every `case` below.
\func boolInd : InductiveId => \new InductiveId (\new Kername (mpFile nil) "BoolBlock") 0

\func primAddRef : LBTerm => const (\new Kername (mpFile nil) "prim_add_int")

\func primSubRef : LBTerm => const (\new Kername (mpFile nil) "prim_sub_int")

\func primEqbRef : LBTerm => const (\new Kername (mpFile nil) "prim_eqb_int")

\func innerRef : LBTerm => const (\new Kername (mpFile nil) "letChainInner")

\func outerRef : LBTerm => const (\new Kername (mpFile nil) "letChainOuter")

\func resRef : LBTerm => const (\new Kername (mpFile nil) "res")

-- `k` nested lets wrapping `body`, each binding `<the previous one> + 1`.
--
-- Every value is `add (bvar 0) 1`: at each step the most recent binding is index
-- 0, so one uniform term serves the whole chain. The FIRST (outermost) let
-- therefore reads whatever index 0 is at the point this is spliced in, which is
-- the accumulator.
\func letsThen (k : Nat) (body : LBTerm) : LBTerm \elim k
  | 0 => body
  | suc k => letIn anon (app2 primAddRef (bvar 0) (prim (primInt, 1))) (letsThen k body)

-- letChainInner, the loop whose body is the chain.
--
-- Inside the fix body the environment is [acc, j, self]; after `n` lets it is
-- [a_n .. a_1, acc, j, self], so `self` is index n+2 and `j` is n+1 -- which is
-- why `letsThen` is given a body computed from `n`.
\func innerBody (n : Nat) : LBTerm =>
  lambda anon (lambda anon (
    case boolInd 0 (app2 primEqbRef (bvar 1) (prim (primInt, 0))) (
      -- j /= 0: run the chain, then recurse on (j - 1) with the last binding
      (nil, letsThen n (app2 (bvar (n Nat.+ 2))
                             (app2 primSubRef (bvar (n Nat.+ 1)) (prim (primInt, 1)))
                             (bvar 0))) ::
      -- j == 0: the accumulator
      (nil, bvar 0) ::
      nil
    )
  ))

\func innerFix (n : Nat) : LBTerm => fix ((\new FixDef LBTerm anon (innerBody n) 0) :: nil) 0

-- letChainOuter: the same loop shape with no lets, only to keep the recursion
-- depth of the whole program proportional to OUTER + INNER rather than to their
-- product. Environment inside its fix body is [acc, i, self].
\func outerBody (inner : Nat) : LBTerm =>
  lambda anon (lambda anon (
    case boolInd 0 (app2 primEqbRef (bvar 1) (prim (primInt, 0))) (
      (nil, app2 (bvar 2)
                 (app2 primSubRef (bvar 1) (prim (primInt, 1)))
                 (app2 innerRef (prim (primInt, inner)) (bvar 0))) ::
      (nil, bvar 0) ::
      nil
    )
  ))

\func outerFix (inner : Nat) : LBTerm => fix ((\new FixDef LBTerm anon (outerBody inner) 0) :: nil) 0

\func resBodyOf (outer : Nat) : LBTerm => app2 outerRef (prim (primInt, outer)) (prim (primInt, 0))

-- Dependents first, as in ExampleMatMul.declsOf.
\func declsOf (lets inner outer : Nat) : GlobalDeclarations =>
  (\new Kername (mpFile nil) "res", constantDecl (\new ConstantBody (just (resBodyOf outer)))) ::
  (\new Kername (mpFile nil) "letChainOuter", constantDecl (\new ConstantBody (just (outerFix inner)))) ::
  (\new Kername (mpFile nil) "letChainInner", constantDecl (\new ConstantBody (just (innerFix lets)))) ::
  (\new Kername (mpFile nil) "prim_eqb_int", constantDecl (\new ConstantBody nothing)) ::
  (\new Kername (mpFile nil) "prim_sub_int", constantDecl (\new ConstantBody nothing)) ::
  (\new Kername (mpFile nil) "prim_add_int", constantDecl (\new ConstantBody nothing)) ::
  -- REQUIRED, not decoration: peregrine checks each `case` for exhaustiveness
  -- against the declared constructor count, and rejects the program
  -- ("Case not exhaustive") if the inductive is missing. Constructor ORDER is
  -- the ABI for `eqb`'s result -- false first, so false is tag 0.
  (\new Kername (mpFile nil) "BoolBlock", inductiveDecl (\new MutualInductiveBody finite 0
                                                             ((\new OneInductiveBody "Bool" false IntoAny
                                                                    ((\new ConstructorBody "false" 0) :: (\new ConstructorBody "true" 0) :: nil)
                                                                    nil) :: nil))) ::
  nil

\func letChainProgramOf (lets inner outer : Nat) : LBProgram => (declsOf lets inner outer, resRef)

-- 20 lets, 10000 x 2000 iterations: 400,000,000 lets evaluated, value
-- 400,000,000, at a recursion depth of ~12000. Sized so the run stage is
-- seconds rather than the ~0.5 s that 2000 x 2000 gave, which is JVM warmup
-- with a program attached (see test/benchmarks.md, "Reading the numbers").
\func letChainProgram : LBProgram => letChainProgramOf 20 10000 2000

\import Data.Maybe
\import Data.String
\import LambdaBox
\import RtLong
\import ExamplePeano
\import JavaAst
\import JavaEval
\import JavaValue
\import Paths
\import ToJava

-- =============================================================================
-- The Java fragment's semantics, run on a compiled program.
--
-- `JavaEval.ard` is executable on purpose (see its header). This is the first
-- thing that executes it: λ□ program -> `compileClass` -> `runClass`, and the
-- result compared with the value the harness expects from the REAL run of the
-- same program (`test/corpora/handwritten/peano/meta`: `1(1(1(1(0))))`, i.e.
-- suc^4 zero, `Nat` being declared zero-then-suc).
--
-- It is a `\lemma` proved by `idp`, so typechecking this module IS the check: if
-- the evaluator disagreed, or got stuck, or ran out of fuel, this would not
-- typecheck. That makes it a cheap differential test against the JVM for one
-- program -- not a proof of anything about the generator, which is what a
-- `Correct` statement relating `LambdaBoxEval` to `JEval` would be.
--
-- WHY HERE and not in the compiler project: this needs a λ□ program, and the
-- committed ones live here. The alternative, `src/Imported/<Module>.ard`, is
-- generated and gitignored, so a module importing it does not typecheck in a
-- fresh clone -- the trap the earlier semantics branch fell into.
-- =============================================================================

-- peano needs NOTHING from the runtime: it has no axioms (that is why it is the
-- smoke set's "canonical small one"), so every field of the interface may say
-- "not covered". An instance that answers nothing is the strongest possible
-- statement that the run below is about the fragment and not about `Rt.java`.
\func rtNone : RtSpec \cowith
  | rtField _ => nothing
  | builtinArity _ => nothing
  | builtinRun _ _ => rStuck
  | rtStaticCall _ _ => nothing

\func peanoClass : JClass => compileClass "Prog" addProgram

-- suc^4 zero, as a value of the fragment: `Nat`'s constructors are zero = tag 0
-- and suc = tag 1, and an erased inductive's parameters are not stored.
\func sucV (v : Value) : Value => vData 1 (v :: nil)

\func zeroV : Value => vData 0 nil

\func four : Value => sucV (sucV (sucV (sucV zeroV)))

-- 1 + 3 = 4, computed by the semantics of the generated Java.
-- (a `\func`, not a `\lemma`: `Res RunOut` is a type, not a proposition.)
\func peanoEvaluates : runClass rtNone peanoClass bodyMethodName 2000 = rOk (rvValue four)
  => idp

-- ---------------------------------------------------------------------------
-- What peano cannot reach: the runtime interface, `proj`, and a throw.
--
-- peano is pure λ□ -- closures, constructors, `case`, `fix` -- so the whole
-- `RtSpec` half of the evaluator (`jField` -> `rtField` -> a `vBuiltin` that
-- accumulates arguments until `builtinRun` computes) is untouched by it, and so
-- is `proj`, which NO PROGRAM IN THE CORPUS exercises (golden.py records that
-- gap). The programs below are written here, minimal, one feature each, with
-- values that can be read off the term.
-- ---------------------------------------------------------------------------

-- An `Fn`-valued axiom: a constant with no body, which `compileDecl` resolves
-- through `javaAxioms` -- `prim_add_int` under the root module path mangles to
-- `c___prim_add_int`, the table's key, and compiles to `Rt.PRIM_ADD_LONG`.
\func primAddKn : Kername => \new Kername (mpFile nil) "prim_add_int"

\func axiomDecls : GlobalDeclarations =>
  (primAddKn, constantDecl (\new ConstantBody nothing)) :: nil

\func litT (i : Int) : LBTerm => prim (primInt, i)

\func addT (a b : LBTerm) : LBTerm => app (app (const primAddKn) a) b

-- 2 + 3 = 5. Reaches `Rt.PRIM_ADD_LONG` as a field, applies it twice (the arity
-- contract: one argument leaves a `vBuiltin` holding it, the second saturates),
-- and boxes the result through `Long.valueOf`.
\func addClass : JClass => compileClass "Prog" (axiomDecls, addT (litT 2) (litT 3))

\func addEvaluates : runClass rtLong addClass bodyMethodName 100 = rOk (rvValue (vLong 5))
  => idp

-- The same, at the edge of the range: (2^63-1) + 1 wraps to -2^63 rather than
-- growing, which is JLS 4.2.2 and the reason `RtLong.wrap64` exists. Arend's
-- `Int` would happily report 9223372036854775808 here, and the JVM does not.
\func wrapClass : JClass =>
  compileClass "Prog" (axiomDecls, addT (litT 9223372036854775807) (litT 1))

\func wrapEvaluates
  : runClass rtLong wrapClass bodyMethodName 100 = rOk (rvValue (vLong (neg 9223372036854775808)))
  => idp

-- `proj`: field 0 of a one-field constructor, with no inductive parameters.
-- Compiles to `((Rt.Data)(e)).fields[0]` -- the path with no corpus coverage at
-- all, which this is the first thing to evaluate.
\func boxInd : InductiveId => \new InductiveId (\new Kername (mpFile nil) "Box") 0

\func projClass : JClass =>
  compileClass "Prog"
    (nil, proj (\new ProjectionInfo boxInd 0 0) (construct boxInd 0 (litT 7 :: nil)))

\func projEvaluates : runClass rtLong projClass bodyMethodName 100 = rOk (rvValue (vLong 7))
  => idp

-- A `case` with NO branches (λ□'s erased `Empty`): the scrutinee is evaluated
-- and cast, and the chain of tag tests ends in `Rt.noBranch`, which throws. So
-- the observable is a THROW, not a value -- the outcome `runClass` reports as
-- `rvThrown` and the reason it is a separate constructor rather than a stuck
-- state.
\func emptyCaseClass : JClass =>
  compileClass "Prog" (nil, case boxInd 0 (construct boxInd 0 nil) nil)

\func emptyCaseThrows
  : runClass rtLong emptyCaseClass bodyMethodName 100
  = rOk (rvThrown (vExcObj "java.lang.IllegalStateException" "matches no branch"))
  => idp
